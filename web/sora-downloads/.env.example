# Portways injects these when its Object Storage add-on is linked.
# Set actual values in the Portways Env tab or a publisher shell, never in Git.
PORT=3000
S3_ENDPOINT=https://YOUR-STORAGE-ENDPOINT
S3_REGION=auto
S3_BUCKET=YOUR-BUCKET
S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are secrets.
# S3_INTERNAL_ENDPOINT is optional and injected by Portways when reachable.
