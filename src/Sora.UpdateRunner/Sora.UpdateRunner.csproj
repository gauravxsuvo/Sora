<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.1.0</Version>
    <ApplicationIcon>../../assets/Sora.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sora.Core/HardwareDiscovery.cs" Link="HardwareDiscovery.cs" />
    <Compile Include="../Sora.Core/Updates/*.cs" Link="Updates/%(Filename)%(Extension)" />
    <Compile Include="../Sora.Update.Windows/*.cs" Link="Windows/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../release/update-policy.json" LogicalName="Sora.UpdatePolicy" />
  </ItemGroup>
</Project>
