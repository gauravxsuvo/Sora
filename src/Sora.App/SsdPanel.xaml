<UserControl x:Class="Sora.App.SsdPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:PageHeader Title="SSD tool" Subtitle="Drive identity, health and S.M.A.R.T. details."><Button x:Name="RefreshButton" Content="Rescan drives" Click="RefreshClick"/></local:PageHeader>
    <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,14,0,14" Text="Read the drives to view their health."/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Physical drives" Style="{StaticResource Eyebrow}" Margin="4,4,4,12"/><Grid><TextBlock x:Name="DriveEmpty" Text="No drive readings yet. Rescan drives to read their details." Style="{StaticResource SecondaryText}" Margin="4,4"/><ListBox x:Name="DriveList" SelectionChanged="DriveChanged" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid></DockPanel></Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}"><StackPanel><TextBlock x:Name="ModelText" Text="Select a drive" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="IdentityText" Style="{StaticResource CaptionText}" Margin="0,10,0,0" Text="Model, firmware, serial number and volumes appear here." TextWrapping="Wrap"/></StackPanel></Border>
          <Border x:Name="FirmwareNoticeCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="FirmwareNoticeTitle" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource WarnTextBrush}"/><TextBlock x:Name="FirmwareNoticeDetail" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap"/><Button Content="Read official firmware advisory" Click="FirmwareNoticeClick" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Drive health" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="HealthEmpty" Text="Drive health has not been read. Unknown does not mean healthy." Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/><Grid x:Name="HealthMetrics" Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HealthText" Text="Unknown" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="TemperatureText" Text="— °C" FontSize="18" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="LifeText" Text="—" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Estimated endurance remaining" Style="{StaticResource CaptionText}"/></StackPanel></Grid><TextBlock x:Name="HealthDetail" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="S.M.A.R.T." Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="ExportButton" Grid.Column="1" Content="Save CSV" Click="ExportClick" IsEnabled="False"/></Grid><TextBlock x:Name="SmartEmpty" Text="No S.M.A.R.T. readings available. Read a drive to view its reported attributes." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/><DataGrid x:Name="SmartGrid" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource InsetBrush}" AlternatingRowBackground="{DynamicResource SurfaceRaisedBrush}" MinHeight="120" MaxHeight="380" FontSize="12" AutomationProperties.Name="Smart"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/><DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="2*" MinWidth="180"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="110"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="110"/><DataGridTextColumn Header="Normalized" Binding="{Binding Normalized}" Width="85"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="75"/></DataGrid.Columns></DataGrid></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Firmware maintenance" Style="{StaticResource Eyebrow}"/><TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" Text="S.M.A.R.T. health does not establish firmware status. Sora does not perform a complete SSD firmware update check. Official maintenance routes are on the Updates page."/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Secure erase" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="EraseText" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" Text="Secure erase is unavailable in Sora."/><Button Content="Erase unavailable" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
