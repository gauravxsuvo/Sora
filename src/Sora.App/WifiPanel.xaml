<UserControl x:Class="Sora.App.WifiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:PageHeader Title="Wi-Fi Compass" Subtitle="Explore your signal. Find a better antenna position.">
      <StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="Refresh" Click="ScanClick" ToolTip="Reads Windows' latest Wi-Fi results. Sora never forces a scan of the card."/><Button Content="Save CSV" Click="ExportClick" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel>
    </local:PageHeader>
    <StackPanel Grid.Row="1">
      <Border x:Name="WifiOffBanner" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0"><TextBlock Text="Turn on Wi-Fi to use Wi-Fi Compass" Foreground="{DynamicResource WarnTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Your Wi-Fi radio is off. Turn it on in Windows to scan networks and measure antenna signal." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel>
          <Button Content="Open Wi-Fi settings" Click="OpenWifiSettingsClick" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,14,0,0" Text="Select a Wi-Fi adapter to begin."/>
    </StackPanel>
    <ScrollViewer x:Name="WifiScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
      <StackPanel Margin="0,0,7,0">
        <Border Style="{StaticResource Card}" Padding="18">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Wi-Fi adapter" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/><ComboBox x:Name="AdapterBox" local:ControlState.Placeholder="No Wi-Fi adapters available" DisplayMemberPath="Description" SelectionChanged="AdapterChanged" AutomationProperties.Name="Wi-Fi adapter"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Signal target" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/><ComboBox x:Name="TargetBox" local:ControlState.Placeholder="No signal targets available" DisplayMemberPath="Label" SelectionChanged="TargetChanged" AutomationProperties.Name="Signal target"/></StackPanel>
            </Grid>
            <TextBlock x:Name="ConnectionText" Style="{StaticResource CaptionText}" Margin="0,12,0,0" Text="No connection details yet."/>
          </StackPanel>
        </Border>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width=".95*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="18">
            <StackPanel>
              <Grid><TextBlock Text="Your antenna" Style="{StaticResource Eyebrow}"/><Button Content="Reset view" Click="ResetViewClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="8,3" Margin="0,-5,0,0"/></Grid>
              <Border CornerRadius="9" ClipToBounds="True" Margin="0,12,0,0"><local:WifiAntennaView x:Name="AntennaView" Height="258"/></Border>
              <TextBlock Text="Drag to rotate · scroll to zoom" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
              <TextBlock Text="Reference model · set the physical antenna position yourself." Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
              <Grid><TextBlock Text="Signal strength" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SignalStateText" Text="WAITING" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/></Grid>
              <Grid Height="185" Margin="0,4,0,0">
                <Canvas x:Name="SignalGauge" ClipToBounds="True" SizeChanged="GaugeSizeChanged"/>
                <StackPanel VerticalAlignment="Center" Margin="0,24,0,0"><TextBlock x:Name="SignalText" Text="— dBm" FontSize="34" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="QualityText" Text="Waiting for a fresh measurement" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
              </Grid>
              <ProgressBar x:Name="SignalMeter" Minimum="0" Maximum="100" Height="3" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" BorderThickness="0" Margin="0,2,0,14"/>
              <UniformGrid Columns="3">
                <StackPanel><TextBlock Text="MINIMUM" Style="{StaticResource CaptionText}" TextAlignment="Center" FontSize="10"/><TextBlock x:Name="MinimumText" Text="—" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="AVERAGE" Style="{StaticResource CaptionText}" TextAlignment="Center" FontSize="10"/><TextBlock x:Name="AverageText" Text="—" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="MAXIMUM" Style="{StaticResource CaptionText}" TextAlignment="Center" FontSize="10"/><TextBlock x:Name="MaximumText" Text="—" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              </UniformGrid>
              <TextBlock x:Name="StatisticsText" Style="{StaticResource CaptionText}" Text="Waiting for fresh measurements · dBm" TextAlignment="Center" Margin="0,10,0,0"/>
              <CheckBox x:Name="LiveCheck" Content="Monitor signal · up to 5 minutes" Margin="0,14,0,0" Checked="LiveChanged" Unchecked="LiveChanged"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="HistorySection" Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
          <StackPanel>
            <Grid><TextBlock Text="Signal history" Style="{StaticResource Eyebrow}"/><TextBlock Text="Last 60 seconds · higher dBm is stronger" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/></Grid>
            <Canvas x:Name="SignalChart" Height="138" Margin="0,14,0,0" ClipToBounds="True" SizeChanged="ChartSizeChanged"/>
          </StackPanel>
        </Border>
        <Border x:Name="PositionSection" Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Find the best position" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Turn the antenna to each position, hold it steady for 15 seconds, and compare the measured averages." Style="{StaticResource CaptionText}" Margin="0,8,0,14"/>
            <UniformGrid Columns="4"><Button x:Name="FrontButton" Tag="Front" Content="1  Front" Click="PositionClick" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/><Button x:Name="LeftButton" Tag="Left" Content="2  Left" Click="PositionClick" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/><Button x:Name="BackButton" Tag="Back" Content="3  Back" Click="PositionClick" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/><Button x:Name="RightButton" Tag="Right" Content="4  Right" Click="PositionClick" Style="{StaticResource QuietButton}"/></UniformGrid>
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <ComboBox x:Name="PositionBox" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="PositionChanged" AutomationProperties.Name="Position"><ComboBoxItem Content="Front"/><ComboBoxItem Content="Left"/><ComboBoxItem Content="Back"/><ComboBoxItem Content="Right"/></ComboBox>
                <TextBlock x:Name="PositionHeading" Text="Position 1 · Front" FontSize="16" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,12,0,0"><Button x:Name="MeasureButton" Content="Measure Front" Click="MeasureClick"/><Button Content="Reset results" Click="ResetClick" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></WrapPanel>
                <ProgressBar x:Name="MeasurementProgress" Minimum="0" Maximum="15" Height="4" Margin="0,14,0,10" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" BorderThickness="0"/>
                <TextBlock x:Name="MeasureText" Style="{StaticResource CaptionText}" Text="Start with the antenna facing forward."/>
                <TextBlock x:Name="BestText" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2"><Canvas x:Name="PositionChart" Height="148" SizeChanged="PositionChartSizeChanged"/><TextBlock x:Name="ResultsText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="Measure all four positions to choose a recommendation."/></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
          <StackPanel><TextBlock Text="Nearby access points" Style="{StaticResource Eyebrow}"/><TextBlock Text="Each BSSID is a separate radio. Last seen shows the age of Windows' cached scan results." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
            <DataGrid x:Name="NetworkGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="285" MinHeight="90" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" GridLinesVisibility="None" RowBackground="{DynamicResource InsetBrush}" AlternatingRowBackground="{DynamicResource SurfaceBrush}" FontSize="12" AutomationProperties.Name="Network">
              <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Padding" Value="8,7"/></Style></DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.CellStyle>
              <DataGrid.Columns><DataGridTextColumn Header="Network" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="130"/><DataGridTextColumn Header="dBm" Binding="{Binding SignalDbm}" Width="55"/><DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="65"/><DataGridTextColumn Header="Ch." Binding="{Binding ChannelLabel}" Width="45"/><DataGridTextColumn Header="Radio" Binding="{Binding Radio}" Width="78"/><DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="65"/><DataGridTextColumn Header="Last seen" Binding="{Binding Age}" Width="95"/></DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
