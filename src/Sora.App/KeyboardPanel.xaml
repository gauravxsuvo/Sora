<UserControl x:Class="Sora.App.KeyboardPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" Focusable="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:PageHeader Title="Keyboard" Subtitle="Lighting, key assignments and profiles for your Kreo keyboard.">
      <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="LayoutPreview" Orientation="Horizontal" Margin="0,0,16,0">
          <TextBlock Text="Preview layout" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="ModelPicker" Width="140" DisplayMemberPath="Name" SelectionChanged="ModelChanged" ToolTip="Shows a layout while no keyboard is connected. The model is detected automatically on connection." AutomationProperties.Name="Preview layout"/>
        </StackPanel>
        <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="KeyboardDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0"/><TextBlock x:Name="KeyboardStatus" Text="Not connected" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Border>
        <Button x:Name="ReadButton" Content="Connect" Click="ReadKeyboard" MinWidth="96"/>
      </StackPanel>
    </local:PageHeader>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,14"><StackPanel><Grid><TextBlock x:Name="BoardTitle" Text="Layout preview" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SelectedKeyLabel" Text="Click a key to select it" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/></Grid><Viewbox Stretch="Uniform" MaxHeight="185" Margin="0,12,0,8"><Canvas x:Name="Board"/></Viewbox><TextBlock x:Name="BoardHint" Text="Select keys here. Edits are saved only when you choose Apply to keyboard." Style="{StaticResource CaptionText}"/></StackPanel></Border>
    <TabControl x:Name="Editors" Grid.Row="2" IsEnabled="False" Margin="0,16,0,0" Padding="0,12,0,0">
      <TabItem Header="Lighting"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Effect" Style="{StaticResource SectionText}"/><ComboBox x:Name="EffectPicker" DisplayMemberPath="Name" SelectionChanged="LightingChanged" Margin="0,12,0,0" AutomationProperties.Name="Effect"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BrightnessLabel" Grid.Column="1" Text="100%" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource NumericText}"/></Grid><Slider x:Name="Brightness" Minimum="0" Maximum="4" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightingChanged" AutomationProperties.Name="Brightness"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Speed" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SpeedLabel" Grid.Column="1" Text="3 / 5" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource NumericText}"/></Grid><Slider x:Name="Speed" Minimum="0" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightingChanged" AutomationProperties.Name="Speed"/><TextBlock x:Name="EffectHint" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Effect color" Style="{StaticResource SectionText}"/><ComboBox x:Name="ColorMode" SelectionChanged="ColorModeChanged" Margin="0,12,0,0" AutomationProperties.Name="Effect color mode"><ComboBoxItem Content="Single hex color"/><ComboBoxItem Content="Multicolor"/></ComboBox><TextBlock Text="Palette · click a color to edit it" Style="{StaticResource FieldLabel}"/><WrapPanel x:Name="EffectSwatches"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="EffectColorPreview" Background="{StaticResource AccentBrush}" CornerRadius="6" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/><TextBox x:Name="EffectHex" Grid.Column="2" Text="#769BFF" MaxLength="7" TextChanged="EffectHexChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Effect hex color"/></Grid><TextBlock x:Name="EffectColorError" Foreground="{StaticResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="EffectColorHint" Text="Type a six-digit hex color. The effect stays selected." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Per-key RGB" Style="{StaticResource SectionText}"/><TextBlock x:Name="PaintTarget" Text="Select a key on the keyboard" Style="{StaticResource SecondaryText}" Margin="0,12,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="PaintColorPreview" Background="{StaticResource AccentBrush}" CornerRadius="6" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/><TextBox x:Name="PaintColor" Grid.Column="2" Text="#769BFF" MaxLength="7" TextChanged="PaintHexChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Paint hex color"/></Grid><TextBlock x:Name="PaintError" Foreground="{StaticResource ErrorTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><Button x:Name="PaintSelectedButton" Content="Paint selected key" Click="PaintKey" Margin="0,8,0,8"/><Button x:Name="PaintAllButton" Content="Fill whole keyboard" Click="PaintAll"/><TextBlock Text="Painting switches lighting to Custom per-key. Select another effect to return to animation." Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel></Border>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="Key assignment"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Choose a key, then its new action" Style="{StaticResource SectionText}"/><TextBlock x:Name="ActionLabel" Text="Select a key on the keyboard above" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,14,0,4"/><TextBlock Text="New action" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TargetKey" DisplayMemberPath="Label" SelectionChanged="TargetChanged" IsTextSearchEnabled="True" AutomationProperties.Name="New action"/><TextBlock x:Name="MappingPreview" Text="Choose a different action to stage a remap." Style="{StaticResource SecondaryText}" Margin="0,10,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="AssignButton" Content="Use this assignment" Click="AssignKey"/><Button Grid.Column="2" Content="Reset selected key" Click="ResetKey"/></Grid><Button Content="Undo all key edits" Click="UndoKeys" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Test the result" Style="{StaticResource SectionText}"/><TextBlock Text="Apply your changes, click the field below, then press the physical key. This shows the action Windows receives." Style="{StaticResource SecondaryText}" Margin="0,12,0,12"/><TextBox x:Name="KeyTest" Text="Click here, then press a key" IsReadOnly="True" PreviewKeyDown="TestKeyPressed" GotKeyboardFocus="TestFocused" AutomationProperties.Name="Key test field"/><TextBlock Text="Key events are displayed only while this field has focus. They are never saved." Style="{StaticResource CaptionText}" Margin="0,12,0,0"/><TextBlock Text="The Fn key keeps its layer function. Targets refer to standard key actions, even if a key was previously remapped." Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel></Border></Grid></ScrollViewer></TabItem>
      <TabItem Header="Profiles"><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Save a setup. Switch it in seconds." Style="{StaticResource SectionText}"/><TextBlock Text="Profiles include lighting, effect palette colors, per-key RGB and key assignments." Style="{StaticResource SecondaryText}" Margin="0,8,0,16"/><WrapPanel><Button Content="Save profile…" Click="SaveProfile" Margin="0,0,8,8"/><Button Content="Load profile…" Click="LoadProfile" Margin="0,0,8,8"/><Button Content="Load last backup" Click="RestoreBackup" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="Loading a profile stages its changes. Use Apply to keyboard below to save them. Your current setup is backed up before each apply." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/></StackPanel></Border></TabItem>
    </TabControl>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="ChangeSummary" Text="No pending changes" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="KeyboardDetail" Text="Use wired USB and close Kreo KB Hub before connecting." Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><Button x:Name="DiscardButton" Grid.Column="1" Content="Discard edits" Click="DiscardEdits" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Apply to keyboard" Click="ApplyChanges" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></Grid></Border>
  </Grid>
</UserControl>
