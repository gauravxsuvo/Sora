<UserControl x:Class="Sora.App.KeyboardPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True">
  <UserControl.Resources>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8EEF9"/><Setter Property="Background" Value="#1B2940"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E8EEF9"/><Setter Property="Background" Value="#1B2940"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="9"/><Setter Property="MinHeight" Value="37"/><Setter Property="MaxDropDownHeight" Value="330"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="#3B4C68" Foreground="#E8EEF9"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2" Foreground="#B6C8E4"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,32,0" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1B2940" BorderBrush="#445A7E" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E8EEF9"/><Setter Property="Background" Value="#1B2940"/><Setter Property="BorderBrush" Value="#3B4C68"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="37"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#121B2B"/><Setter Property="BorderBrush" Value="#28364E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A4B3CA"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  </UserControl.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Keyboard studio" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="KeyboardStatus" Text="Connect a keyboard to get started" FontSize="13" Foreground="#AFC6FF" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="ModelPicker" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="ModelChanged" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Layout preview; model is detected automatically on connection"/><Button x:Name="ReadButton" Grid.Column="2" Content="Connect / refresh" Click="ReadKeyboard" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,14" Padding="16,12"><StackPanel><Grid><TextBlock x:Name="BoardTitle" Text="LAYOUT PREVIEW" FontSize="10" Foreground="#A4B3CA"/><TextBlock x:Name="SelectedKeyLabel" Text="Click a key to select it" HorizontalAlignment="Right" FontSize="12" Foreground="#B9CCFF"/></Grid><Viewbox Stretch="Uniform" MaxHeight="185" Margin="0,12,0,7"><Canvas x:Name="Board"/></Viewbox><TextBlock x:Name="BoardHint" Text="Select keys here. Edits are saved only when you choose Apply to keyboard." Foreground="#92A5C0" FontSize="11"/></StackPanel></Border>
    <TabControl x:Name="Editors" Grid.Row="2" IsEnabled="False" Background="#0C111D" BorderThickness="0" Padding="0,12,0,0">
      <TabItem Header="Lighting"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Effect" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="EffectPicker" DisplayMemberPath="Name" SelectionChanged="LightingChanged" Margin="0,12,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Brightness" Style="{StaticResource Label}"/><TextBlock x:Name="BrightnessLabel" Grid.Column="1" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B5CAFF"/></Grid><Slider x:Name="Brightness" Minimum="0" Maximum="4" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightingChanged"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Speed" Style="{StaticResource Label}"/><TextBlock x:Name="SpeedLabel" Grid.Column="1" Text="3 / 5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B5CAFF"/></Grid><Slider x:Name="Speed" Minimum="0" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightingChanged"/><TextBlock x:Name="EffectHint" TextWrapping="Wrap" Foreground="#92A5C0" FontSize="11" Margin="0,15,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Effect color" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="ColorMode" SelectionChanged="ColorModeChanged" Margin="0,12,0,0"><ComboBoxItem Content="Single hex color"/><ComboBoxItem Content="Multicolor"/></ComboBox><TextBlock Text="Palette · click a color to edit it" Style="{StaticResource Label}"/><WrapPanel x:Name="EffectSwatches"/><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="EffectColorPreview" Background="#769BFF" CornerRadius="6" BorderBrush="#607396" BorderThickness="1"/><TextBox x:Name="EffectHex" Grid.Column="2" Text="#769BFF" MaxLength="7" TextChanged="EffectHexChanged" FontFamily="Consolas"/></Grid><TextBlock x:Name="EffectColorError" Foreground="#FFABAA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="EffectColorHint" Text="Type a six-digit hex color. The effect stays selected." Foreground="#92A5C0" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Per-key RGB" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PaintTarget" Text="Select a key on the keyboard" Foreground="#B9CCFF" FontSize="12" Margin="0,12,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="PaintColorPreview" Background="#769BFF" CornerRadius="6" BorderBrush="#607396" BorderThickness="1"/><TextBox x:Name="PaintColor" Grid.Column="2" Text="#769BFF" MaxLength="7" TextChanged="PaintHexChanged" FontFamily="Consolas"/></Grid><TextBlock x:Name="PaintError" Foreground="#FFABAA" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/><Button x:Name="PaintSelectedButton" Content="Paint selected key" Click="PaintKey" FontSize="12" Margin="0,8,0,8"/><Button x:Name="PaintAllButton" Content="Fill whole keyboard" Click="PaintAll" FontSize="12"/><TextBlock Text="Painting switches lighting to Custom per-key. Select another effect to return to animation." TextWrapping="Wrap" Foreground="#92A5C0" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="Key assignment"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Choose a key, then its new action" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ActionLabel" Text="Select a key on the keyboard above" FontSize="21" Foreground="#B9CCFF" Margin="0,15,0,4"/><TextBlock Text="New action" Style="{StaticResource Label}"/><ComboBox x:Name="TargetKey" DisplayMemberPath="Label" SelectionChanged="TargetChanged" IsTextSearchEnabled="True"/><TextBlock x:Name="MappingPreview" Text="Choose a different action to stage a remap." TextWrapping="Wrap" Foreground="#A4B3CA" FontSize="12" Margin="0,10,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="AssignButton" Content="Use this assignment" Click="AssignKey" FontSize="12"/><Button Grid.Column="2" Content="Reset selected key" Click="ResetKey" FontSize="12"/></Grid><Button Content="Undo all key edits" Click="UndoKeys" FontSize="12" Margin="0,9,0,0" HorizontalAlignment="Left"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Test the result" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Apply your changes, click the field below, then press the physical key. This shows the action Windows receives." TextWrapping="Wrap" Foreground="#A4B3CA" FontSize="13" Margin="0,13,0,12"/><TextBox x:Name="KeyTest" Text="Click here, then press a key" IsReadOnly="True" PreviewKeyDown="TestKeyPressed" GotKeyboardFocus="TestFocused"/><TextBlock Text="Key events are displayed only while this field has focus. They are never saved." TextWrapping="Wrap" Foreground="#92A5C0" FontSize="11" Margin="0,12,0,0"/><TextBlock Text="The Fn key keeps its layer function. Targets refer to standard key actions, even if a key was previously remapped." TextWrapping="Wrap" Foreground="#92A5C0" FontSize="11" Margin="0,16,0,0"/></StackPanel></Border></Grid></ScrollViewer></TabItem>
      <TabItem Header="Profiles"><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Save a setup. Switch it in seconds." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Profiles include lighting, effect palette colors, per-key RGB and key assignments." Foreground="#A4B3CA" Margin="0,9,0,18" TextWrapping="Wrap"/><WrapPanel><Button Content="Save profile…" Click="SaveProfile" Margin="0,0,10,10"/><Button Content="Load profile…" Click="LoadProfile" Margin="0,0,10,10"/><Button Content="Load last backup" Click="RestoreBackup" Margin="0,0,10,10"/></WrapPanel><TextBlock Text="Loading a profile stages its changes. Use Apply to keyboard below to save them. Your current setup is backed up before each apply." TextWrapping="Wrap" Foreground="#92A5C0" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border></TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#17243A" BorderBrush="#324866" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock x:Name="ChangeSummary" Text="No pending changes" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="KeyboardDetail" Text="Use wired USB and close Kreo KB Hub before connecting." Foreground="#A4B3CA" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="DiscardButton" Grid.Column="1" Content="Discard edits" Click="DiscardEdits" IsEnabled="False" Margin="0,0,9,0"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Apply to keyboard" Click="ApplyChanges" IsEnabled="False" Background="#80A3FF" Foreground="#091426" FontWeight="SemiBold"/></Grid></Border>
  </Grid>
</UserControl>
