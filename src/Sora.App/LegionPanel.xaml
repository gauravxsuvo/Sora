<UserControl x:Class="Sora.App.LegionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,16">
      <local:PageHeader Title="Lenovo Legion" Subtitle="Power, charging and keyboard lighting.">
        <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" Style="{StaticResource QuietButton}"/>
      </local:PageHeader>
      <Border Style="{StaticResource Card}" Margin="0,18,0,16"><StackPanel>
        <TextBlock x:Name="ModelText" Text="Lenovo Legion" FontSize="22"/>
        <TextBlock x:Name="IdentityText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
        <TextBlock Text="Experimental Legion support" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
        <TextBlock x:Name="StatusText" Text="Refresh to read this laptop's available controls." TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Performance mode" FontSize="19"/>
        <TextBlock x:Name="CurrentPower" Text="Current mode: unavailable" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
        <ComboBox x:Name="PowerPicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion performance mode"/>
        <TextBlock Text="Quiet reduces noise. Balanced adjusts to your workload. Performance requires AC power." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ApplyPower" Content="Apply mode" Click="ApplyPowerClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RestorePower" Content="Restore original mode" Click="RestorePowerClick" Style="{StaticResource QuietButton}" IsEnabled="False"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Battery charging" FontSize="19"/>
        <TextBlock x:Name="CurrentCharge" Text="Current charging mode: unavailable" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
        <ComboBox x:Name="ChargePicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion charging mode"/>
        <TextBlock Text="Conservation limits charging according to your laptop's firmware. Rapid charge prioritizes charging speed." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ApplyCharge" Content="Apply charging mode" Click="ApplyChargeClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RestoreCharge" Content="Restore original charging" Click="RestoreChargeClick" Style="{StaticResource QuietButton}" IsEnabled="False"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Graphics mode" FontSize="19"/>
        <TextBlock x:Name="CurrentGpu" Text="Firmware configuration: unavailable" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
        <ComboBox x:Name="GpuPicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion graphics mode"/>
        <TextBlock Text="Changes the laptop's firmware graphics setting. A restart may be needed to change active display routing. External displays and running GPU applications can affect switching." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ApplyGpu" Content="Apply graphics mode" Click="ApplyGpuClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RestoreGpu" Content="Restore original graphics mode" Click="RestoreGpuClick" Style="{StaticResource QuietButton}" IsEnabled="False"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Four-zone keyboard lighting" FontSize="19"/>
        <TextBlock x:Name="KeyboardText" Text="No supported four-zone interface detected." Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
        <ComboBox x:Name="KeyboardPicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion keyboard interface" Margin="0,0,0,8"/>
        <ComboBox x:Name="EffectPicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion lighting effect"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Speed" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SpeedPicker" AutomationProperties.Name="Legion lighting speed"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BrightnessPicker" AutomationProperties.Name="Legion lighting brightness"/></StackPanel>
        </Grid>
        <UniformGrid Columns="4" Margin="0,12,0,0">
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Zone 1" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Zone1" Text="#38BDF8" AutomationProperties.Name="Legion zone 1 color"/></StackPanel>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Zone 2" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Zone2" Text="#818CF8" AutomationProperties.Name="Legion zone 2 color"/></StackPanel>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Zone 3" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Zone3" Text="#C084FC" AutomationProperties.Name="Legion zone 3 color"/></StackPanel>
          <StackPanel><TextBlock Text="Zone 4" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Zone4" Text="#F472B6" AutomationProperties.Name="Legion zone 4 color"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="Enter colors as #RRGGBB. Zone colors apply to Static and Breathing. Original keyboard colors cannot be read back." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ApplyLighting" Content="Apply lighting" Click="ApplyLightingClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="OffLighting" Content="Turn lighting off" Click="OffLightingClick" Style="{StaticResource QuietButton}" IsEnabled="False"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Spectrum keyboard profiles" FontSize="19"/>
        <TextBlock x:Name="SpectrumText" Text="No compatible Spectrum controller detected." Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
        <ComboBox x:Name="SpectrumPicker" DisplayMemberPath="Label" AutomationProperties.Name="Legion Spectrum keyboard" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Profile" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SpectrumProfile" AutomationProperties.Name="Legion Spectrum profile"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Brightness · 0 is off" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SpectrumBrightness" AutomationProperties.Name="Legion Spectrum brightness"/></StackPanel>
        </Grid>
        <TextBlock Text="Selects a profile stored on the keyboard. Profile effects are preserved. Per-key effect editing is not available yet." Style="{StaticResource CaptionText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ApplySpectrum" Content="Apply Spectrum settings" Click="ApplySpectrumClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RestoreSpectrum" Content="Restore original settings" Click="RestoreSpectrumClick" Style="{StaticResource QuietButton}" IsEnabled="False"/></WrapPanel>
      </StackPanel></Border>
      <TextBlock x:Name="ProblemsText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
