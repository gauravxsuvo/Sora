<Window x:Class="Sora.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Sora" Icon="/Sora;component/Assets/Sora.ico" Width="1320" Height="860" MinWidth="1080" MinHeight="720" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UIFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource SidebarWidth}"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="Sora" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="WindowClose" Style="{StaticResource TrafficLightButton}" Background="#FF5F57" Click="CloseWindowClick" AutomationProperties.Name="Close window" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="WindowMinimize" Style="{StaticResource TrafficLightButton}" Background="#FEBC2E" Click="MinimizeWindowClick" AutomationProperties.Name="Minimize window" ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="WindowMaximize" Style="{StaticResource TrafficLightButton}" Background="#28C840" Click="MaximizeWindowClick" AutomationProperties.Name="Maximize or restore window" ToolTip="Maximize / Restore" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar: single-line navigation; connection and check status belongs to the active page. -->
    <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="{StaticResource SidebarInset}" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource SidebarBrandSpacing}">
          <Path Data="{StaticResource SoraMark}" Fill="{DynamicResource SoraBrandBrush}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Sora logo"/>
          <TextBlock Text="Sora" FontSize="{StaticResource SidebarBrandFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Height="34" Margin="{StaticResource SearchInset}">
          <TextBox x:Name="NavSearchBox" Style="{StaticResource NavigationSearchBox}" TextChanged="NavSearchChanged" PreviewKeyDown="NavSearchKeyDown" AutomationProperties.Name="Search pages and devices" ToolTip="Filter pages and devices"/>
          <ContentControl Content="{StaticResource IconSearch}" Style="{StaticResource UtilityIcon}" Width="14" Height="14" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBlock x:Name="NavSearchPlaceholder" Text="Search" FontSize="13" Foreground="{DynamicResource TertiaryTextBrush}" Margin="34,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Button x:Name="NavSearchClear" Click="ClearNavSearch" Style="{StaticResource QuietButton}" Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Clear search" AutomationProperties.Name="Clear navigation search">
            <ContentControl Content="{StaticResource IconClose}" Style="{StaticResource UtilityIcon}" Width="12" Height="12"/>
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" Text="Sora 0.4" Style="{StaticResource CaptionText}" Margin="10,0,0,0"/>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="{StaticResource SidebarFooterSpacing}">
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Settings" ToolTip="Settings  (Ctrl+0)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions><ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconSettings}" Style="{StaticResource NavIcon}"/></ContentControl><TextBlock Grid.Column="2" Text="Settings" Style="{StaticResource SidebarLabel}"/></Grid>
          </RadioButton>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
        <StackPanel>
          <TextBlock Text="Cooling" Style="{StaticResource SidebarSectionText}" Margin="{StaticResource SidebarFirstSectionSpacing}"/>
          <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="NavChanged" AutomationProperties.Name="Cooler display" ToolTip="Cooler display  (Ctrl+1)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconMonitor}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Cooler display" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavFans" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Fan control" ToolTip="Fan control  (Ctrl+4)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconFan}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Fan control" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="GPU fans" ToolTip="GPU fans  (Ctrl+5)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconGpu}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="GPU fans" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <TextBlock Text="Peripherals" Style="{StaticResource SidebarSectionText}"/>
          <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Keyboard" ToolTip="Keyboard  (Ctrl+2)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconKeyboard}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Keyboard" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Lighting" ToolTip="Lighting  (Ctrl+3)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconLighting}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Lighting" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavLogitech" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Logitech" ToolTip="Logitech  (Ctrl+9)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconMouse}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Logitech" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <TextBlock Text="System" Style="{StaticResource SidebarSectionText}"/>
          <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="SSD tool" ToolTip="SSD tool  (Ctrl+6)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconStorage}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="SSD tool" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavWifi" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Wi-Fi antenna" ToolTip="Wi-Fi antenna  (Ctrl+7)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconWifi}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Wi-Fi antenna" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Updates" ToolTip="Updates  (Ctrl+8)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconColumnWidth}"/><ColumnDefinition Width="{StaticResource NavigationIconLabelGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource NavigationIconBox}"><ContentControl Content="{StaticResource IconDownload}" Style="{StaticResource NavIcon}"/></ContentControl>
              <TextBlock Grid.Column="2" Text="Updates" Style="{StaticResource SidebarLabel}"/>
            </Grid>
          </RadioButton>
          <TextBlock x:Name="NavEmptyState" Text="No matching pages" Style="{StaticResource CaptionText}" Margin="10,12,8,0" Visibility="Collapsed"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Margin="{StaticResource PageInset}">
      <!-- Cooler display page: readings (left), device status (right), settings (bottom). -->
      <ScrollViewer x:Name="DisplayPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:PageHeader Title="Cooler display" Subtitle="Shows live CPU readings on the screen of your DeepCool LD360.">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DisplayDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0"/><TextBlock x:Name="DeviceLabel" Text="Display off" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Border>
            <Button x:Name="StartButton" Content="Start display" Style="{StaticResource PrimaryButton}" MinWidth="132" Click="ToggleDisplay"/>
          </StackPanel>
        </local:PageHeader>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

          <!-- Readings: one hero value, two secondary metrics. Dashes, never stale numbers, when sensors are not live. -->
          <Border Style="{StaticResource Card}" Padding="28,22,28,20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="CPU temperature" Style="{StaticResource Eyebrow}"/>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="80" FontWeight="Light" Style="{StaticResource NumericText}" TextAlignment="Center" MinWidth="220" HorizontalAlignment="Center"><Run x:Name="TemperatureValue" Text="–"/><Run x:Name="TemperatureUnit" Text="&#x2009;°C" FontSize="32" Foreground="{DynamicResource SecondaryTextBrush}" BaselineAlignment="Baseline"/></TextBlock>
                <TextBlock x:Name="TemperatureUnavailableHint" Text="Waiting for CPU sensor data" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                <StackPanel Margin="0,14,0,0"><TextBlock Text="Usage" Style="{StaticResource CaptionText}"/><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="UsageValue" Text="--" FontSize="30" FontWeight="Light" Style="{StaticResource NumericText}"/><TextBlock Text="%" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel></StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" Margin="0,14,24,0"/>
                <StackPanel Grid.Column="2" Margin="0,14,0,0"><TextBlock Text="Package power" Style="{StaticResource CaptionText}"/><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="PowerValue" Text="--" FontSize="30" FontWeight="Light" Style="{StaticResource NumericText}"/><TextBlock Text="W" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel></StackPanel>
              </Grid>
              <Grid Grid.Row="3">
                <TextBlock x:Name="CpuLabel" Text="CPU" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,140,0"/>
                <TextBlock x:Name="LastUpdate" Text="No readings yet" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Status: three independent facts, each with its own state. -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Grid Margin="0,0,0,4"><TextBlock Text="Status" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="SensorInfoButton" Content="About sensors" Click="ToggleSensorInfo" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,-6,-8,-6"/></Grid>
              <Grid Margin="0,8,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="CPU sensors" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="SensorDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="SensorValue" Text="Starting" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="SensorDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <TextBlock x:Name="SensorInfo" Visibility="Collapsed" Style="{StaticResource CaptionText}" Margin="0,-4,0,12" Text="Sora reads CPU package temperature, power and usage itself, through LibreHardwareMonitor and the PawnIO driver. DeepCool's software and service are not needed. Reading CPU registers requires administrator rights, which is why Windows asks when Sora starts."/>
              <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
              <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LD360" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="CoolerDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="CoolerValue" Text="Checking" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="CoolerDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
              <Grid Margin="0,10,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Display output" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="OutputDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="OutputValue" Text="Off" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="OutputDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <!-- What the cooler's screen shows, with the current unit and leading-zero settings. -->
              <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10,16,12">
                <StackPanel>
                  <TextBlock x:Name="PreviewCaption" Text="Preview · not being sent" Style="{StaticResource CaptionText}"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewTemperature" Text="— °C" FontFamily="Bahnschrift" FontSize="30" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PreviewUsage" Text="— %  USAGE" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="PreviewPower" Text="— W  POWER" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Settings, grouped by what they affect. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="24,16,24,12">
          <Grid>
            <StackPanel>
              <TextBlock Text="Cooler" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <local:SettingsGrid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Show Fahrenheit" Style="{StaticResource SettingNameText}"/><TextBlock Text="Converts readings here and on the cooler." Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
                <CheckBox x:Name="FahrenheitCheck" Grid.Row="0" Grid.Column="2" Width="40" HorizontalAlignment="Right" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Show Fahrenheit"/>
                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0"><TextBlock Text="Leading zeros" Style="{StaticResource SettingNameText}"/><TextBlock Text="Shows 045 instead of 45 on the cooler." Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
                <CheckBox x:Name="ZerosCheck" Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Right" Margin="0,8,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Leading zeros"/>
                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0"><TextBlock Text="Turn on when Sora starts" Style="{StaticResource SettingNameText}"/><TextBlock Text="Starts sending as soon as Sora opens or signs in." Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
                <CheckBox x:Name="AutoDisplayCheck" Grid.Row="2" Grid.Column="2" Width="40" HorizontalAlignment="Right" Margin="0,8,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Turn on when Sora starts"/>
              </local:SettingsGrid>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      </ScrollViewer>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PageHeader Title="Settings" Subtitle="Choose how Sora starts and runs in the background."/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>
                <CheckBox x:Name="DarkModeCheck" Content="Dark mode" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Dark mode"/>
                <TextBlock Text="AMOLED black, charcoal panels, and neutral controls. Your choice is saved automatically." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
              <StackPanel><TextBlock Text="Hardware" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="HardwareStatusText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,20">
              <StackPanel>
                <TextBlock Text="App" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>
                <local:SettingsGrid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Start at sign-in" Style="{StaticResource SettingNameText}"/><TextBlock Text="Opens in the tray with administrator rights, without a prompt." Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
                  <CheckBox x:Name="StartupCheck" Grid.Row="0" Grid.Column="2" Width="40" HorizontalAlignment="Right" Checked="StartupChanged" Unchecked="StartupChanged" AutomationProperties.Name="Start at sign-in"/>
                  <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,14,0,0"><TextBlock Text="Keep running in the tray" Style="{StaticResource SettingNameText}"/><TextBlock Text="Closing or minimizing the window keeps Sora and your device controls running. Use Exit Sora in the tray to quit." Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
                  <CheckBox x:Name="TrayCheck" Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Right" Margin="0,14,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Keep running in the tray"/>
                </local:SettingsGrid>
                <TextBlock x:Name="StartupHint" Visibility="Collapsed" Style="{StaticResource SecondaryText}" FontSize="12" Foreground="{DynamicResource WarnTextBrush}" Margin="0,14,0,0" Text="Sora will start at sign-in, but the cooler display stays off until “Turn on when Sora starts” is enabled on the Cooler display page."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Windows startup" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <TextBlock HorizontalAlignment="Left" Text="Sora starts through a scheduled task so it can run with administrator rights at sign-in. This task does not appear in Windows Settings or Task Manager’s Startup apps list." Style="{StaticResource SecondaryText}" FontSize="12"/>
                <TextBlock HorizontalAlignment="Left" Text="Use Start at sign-in above to manage it, or find Sora in Task Scheduler Library." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,12"/>
                <TextBlock x:Name="StartupRouteDetails" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                <Button Content="Open Task Scheduler" Click="OpenTaskScheduler" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <local:KeyboardPanel x:Name="Keyboard" Visibility="Collapsed"/>
      <local:LightingPanel x:Name="Lighting" Visibility="Collapsed"/>
      <local:FanPanel x:Name="Fans" Visibility="Collapsed"/>
      <local:GpuFanPanel x:Name="GpuFans" Visibility="Collapsed"/>
      <local:SsdPanel x:Name="Storage" Visibility="Collapsed"/>
      <local:WifiPanel x:Name="Wifi" Visibility="Collapsed"/>
      <local:UpdatesPanel x:Name="Updates" Visibility="Collapsed"/>
      <local:LogitechPanel x:Name="Logitech" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
