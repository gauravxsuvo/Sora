<Window x:Class="Sora.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" Title="Sora" Width="1260" Height="860" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- Sidebar: brand, one entry per device with a short glanceable status, version. -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,22,12,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,28">
          <Border CornerRadius="8" Width="28" Height="28" Margin="0,0,10,0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4DA3FF" Offset="0"/><GradientStop Color="#0A6CFF" Offset="1"/></LinearGradientBrush></Border.Background>
            <TextBlock Text="S" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
          </Border>
          <TextBlock Text="Sora" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" Text="Sora 0.4" Style="{StaticResource CaptionText}" Margin="10,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Devices" Style="{StaticResource Eyebrow}" Margin="10,0,0,8"/>
          <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="NavChanged" AutomationProperties.Name="Cooler display" ToolTip="Cooler display  (Ctrl+1)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Cooler display" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavDisplayDot" Style="{StaticResource StatusDot}" Width="7" Height="7" Margin="0,1,7,0"/><TextBlock x:Name="NavDisplayStatus" Text="LD360 · Off" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Keyboard" ToolTip="Keyboard  (Ctrl+2)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Keyboard" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavKeyboardDot" Style="{StaticResource StatusDot}" Width="7" Height="7" Margin="0,1,7,0"/><TextBlock x:Name="NavKeyboardStatus" Text="Kreo · Not connected" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="32,28,32,22">
      <!-- Cooler display page: readings (left), device status (right), settings (bottom). -->
      <Grid x:Name="DisplayPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:PageHeader Title="Cooler display" Subtitle="Shows live CPU readings on the screen of your DeepCool LD360.">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DisplayDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0"/><TextBlock x:Name="DeviceLabel" Text="Display off" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Border>
            <Button x:Name="StartButton" Content="Start display" Style="{StaticResource PrimaryButton}" MinWidth="132" Click="ToggleDisplay"/>
          </StackPanel>
        </local:PageHeader>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

          <!-- Readings: one hero value, two secondary metrics. Dashes, never stale numbers, when sensors are not live. -->
          <Border Style="{StaticResource Card}" Padding="28,22,28,20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="CPU temperature" Style="{StaticResource Eyebrow}"/>
              <!-- Scales with the space available, up to roughly twice its base size. -->
              <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" MaxHeight="210" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,4,0,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TemperatureValue" Text="--" FontSize="92" FontWeight="Light" Style="{StaticResource NumericText}"/>
                <TextBlock x:Name="TemperatureUnit" Text="°C" FontSize="30" FontWeight="Light" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="4,20,0,0"/>
              </StackPanel>
              </Viewbox>
              <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                <StackPanel Margin="0,14,0,0"><TextBlock Text="Usage" Style="{StaticResource CaptionText}"/><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="UsageValue" Text="--" FontSize="30" FontWeight="Light" Style="{StaticResource NumericText}"/><TextBlock Text="%" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel></StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0" Margin="0,14,24,0"/>
                <StackPanel Grid.Column="2" Margin="0,14,0,0"><TextBlock Text="Package power" Style="{StaticResource CaptionText}"/><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="PowerValue" Text="--" FontSize="30" FontWeight="Light" Style="{StaticResource NumericText}"/><TextBlock Text="W" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel></StackPanel>
              </Grid>
              <Grid Grid.Row="3">
                <TextBlock x:Name="CpuLabel" Text="CPU" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,140,0"/>
                <TextBlock x:Name="LastUpdate" Text="No readings yet" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Status: three independent facts, each with its own state. -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Grid Margin="0,0,0,4"><TextBlock Text="Status" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="SensorInfoButton" Content="About sensors" Click="ToggleSensorInfo" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,-6,-8,-6"/></Grid>
              <Grid Margin="0,8,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="CPU sensors" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="SensorDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="SensorValue" Text="Starting" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="SensorDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <TextBlock x:Name="SensorInfo" Visibility="Collapsed" Style="{StaticResource CaptionText}" Margin="0,-4,0,12" Text="Sora reads CPU package temperature, power and usage itself, through LibreHardwareMonitor and the PawnIO driver. DeepCool's software and service are not needed. Reading CPU registers requires administrator rights, which is why Windows asks when Sora starts."/>
              <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
              <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LD360" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="CoolerDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="CoolerValue" Text="Checking" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="CoolerDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
              <Grid Margin="0,10,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Display output" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="OutputDot" Style="{StaticResource StatusDot}" Margin="0,0,7,0"/><TextBlock x:Name="OutputValue" Text="Off" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                <TextBlock x:Name="OutputDetail" Grid.Row="1" Grid.ColumnSpan="2" Text="" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
              </Grid>
              <!-- What the cooler's screen shows, with the current unit and leading-zero settings. -->
              <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10,16,12">
                <StackPanel>
                  <TextBlock x:Name="PreviewCaption" Text="Preview · not being sent" Style="{StaticResource CaptionText}"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewTemperature" Text="— °C" FontFamily="Bahnschrift" FontSize="30" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PreviewUsage" Text="— %  USAGE" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="PreviewPower" Text="— W  POWER" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Settings, grouped by what they affect. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="24,16,24,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Cooler" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <CheckBox x:Name="FahrenheitCheck" Margin="0,0,0,6" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Show Fahrenheit"><StackPanel><TextBlock Text="Show Fahrenheit" FontSize="14"/><TextBlock Text="Converts readings here and on the cooler." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
              <CheckBox x:Name="ZerosCheck" Margin="0,0,0,6" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Leading zeros"><StackPanel><TextBlock Text="Leading zeros" FontSize="14"/><TextBlock Text="Shows 045 instead of 45 on the cooler." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
              <CheckBox x:Name="AutoDisplayCheck" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Turn on when Sora starts"><StackPanel><TextBlock Text="Turn on when Sora starts" FontSize="14"/><TextBlock Text="Starts sending as soon as Sora opens or signs in." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="App" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <CheckBox x:Name="StartupCheck" Margin="0,0,0,6" Checked="StartupChanged" Unchecked="StartupChanged" AutomationProperties.Name="Start at sign-in"><StackPanel><TextBlock Text="Start at sign-in" FontSize="14"/><TextBlock Text="Opens in the tray with administrator rights, without a prompt." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
              <CheckBox x:Name="TrayCheck" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="Keep running in the tray"><StackPanel><TextBlock Text="Keep running in the tray" FontSize="14"/><TextBlock Text="Closing the window keeps the cooler display running." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
              <TextBlock x:Name="StartupHint" Visibility="Collapsed" Style="{StaticResource CaptionText}" Foreground="{StaticResource WarnTextBrush}" Margin="0,10,0,0" Text="Sora will start at sign-in, but the cooler display stays off until “Turn on when Sora starts” is on."/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <local:KeyboardPanel x:Name="Keyboard" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
