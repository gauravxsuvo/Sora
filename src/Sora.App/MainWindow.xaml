<Window x:Class="Sora.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" Title="Sora · Hardware hub" Width="1260" Height="860" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0C111D" Foreground="#F2F5FC">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- Sidebar: brand, one entry per device with its live status, version. -->
    <Border Background="#090E18" BorderBrush="#18202F" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,22,14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
          <Border Background="#769BFF" CornerRadius="10" Width="36" Height="36" Margin="0,0,11,0"><TextBlock Text="S" Foreground="#0C111D" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="sora" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Hardware hub" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
          <TextBlock x:Name="VersionLabel" Text="Sora 0.4" FontSize="11" Foreground="#64748E"/>
          <TextBlock Text="Ctrl+1 · Ctrl+2 to switch" FontSize="10" Foreground="#4C5872" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="DEVICES" Style="{StaticResource Eyebrow}" Margin="10,0,0,10"/>
          <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="NavChanged" AutomationProperties.Name="Cooler display">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="17" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Cooler display" FontSize="14" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavDisplayDot" Width="7" Height="7" Fill="{StaticResource Idle}" Margin="0,1,6,0"/><TextBlock x:Name="NavDisplayStatus" Text="LD360 · stopped" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Keyboard">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE765;" FontFamily="{StaticResource Icons}" FontSize="17" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Keyboard" FontSize="14" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavKeyboardDot" Width="7" Height="7" Fill="{StaticResource Idle}" Margin="0,1,6,0"/><TextBlock x:Name="NavKeyboardStatus" Text="Kreo · not connected" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Cooler display page. -->
    <Grid x:Name="DisplayPage" Grid.Column="1" Margin="32,26,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Cooler display" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Live CPU temperature, load and power on your DeepCool LD360." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border BorderBrush="#2D374C" BorderThickness="1" CornerRadius="15" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DisplayDot" Width="8" Height="8" Fill="{StaticResource Idle}" Margin="0,0,8,0"/><TextBlock x:Name="DeviceLabel" Text="LD360" FontSize="11" Foreground="#B6C6E4"/></StackPanel></Border>
          <Button x:Name="StartButton" Content="Start display" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="ToggleDisplay"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="#171F30" CornerRadius="13" Padding="22,18"><StackPanel><TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,2"><TextBlock x:Name="TemperatureValue" Text="—" FontSize="43" FontWeight="SemiBold"/><TextBlock x:Name="TemperatureUnit" Text="°C" FontSize="19" Foreground="#9EB9FF" Margin="8,18,0,0"/></StackPanel><TextBlock Text="Package sensor" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#171F30" CornerRadius="13" Padding="22,18"><StackPanel><TextBlock Text="CPU UTILIZATION" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,2"><TextBlock x:Name="UsageValue" Text="—" FontSize="43" FontWeight="SemiBold"/><TextBlock Text="%" FontSize="19" Foreground="#9EB9FF" Margin="8,18,0,0"/></StackPanel><TextBlock Text="Across all cores" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
        <Border Grid.Column="4" Background="#171F30" CornerRadius="13" Padding="22,18"><StackPanel><TextBlock Text="CPU POWER" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,2"><TextBlock x:Name="PowerValue" Text="—" FontSize="43" FontWeight="SemiBold"/><TextBlock Text="W" FontSize="19" Foreground="#9EB9FF" Margin="8,18,0,0"/></StackPanel><TextBlock Text="Package power" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="24,20">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="ON YOUR COOLER" Style="{StaticResource Eyebrow}"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="300" MaxWidth="560" Margin="0,16">
              <Border Background="#090F19" CornerRadius="13" Padding="26,16" Width="380" BorderBrush="#1B2539" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" FontSize="10" Foreground="#7D8DA7"/><TextBlock x:Name="PreviewTemperature" Text="— °C" FontFamily="Bahnschrift" FontSize="39" Margin="0,2,0,8"/><TextBlock x:Name="PreviewUsage" Text="— %  USAGE" FontFamily="Consolas" FontSize="16" Foreground="#B7C9EB"/><TextBlock x:Name="PreviewPower" Text="— W  POWER" FontFamily="Consolas" FontSize="16" Foreground="#B7C9EB" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="#6693FF" Width="3" CornerRadius="2" Margin="15,8,0,8"/></Grid>
              </Border>
            </Viewbox>
            <Border Background="#172238" CornerRadius="10" Padding="14,12"><StackPanel><TextBlock x:Name="ConnectionTitle" Text="Ready to connect" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionDetail" Text="Exit DeepCool, then start the display." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="PREFERENCES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Display and app" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,16"/>
            <CheckBox x:Name="FahrenheitCheck" Content="Show temperature in Fahrenheit" Margin="0,0,0,14" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="ZerosCheck" Content="Keep leading zeros" Margin="0,0,0,14" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="TrayCheck" Content="Keep running in the tray when I close the window" Margin="0,0,0,14" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="StartupCheck" Content="Start Sora when I sign in to Windows" Margin="0,0,0,14" Checked="StartupChanged" Unchecked="StartupChanged" ToolTip="Starts in the tray with administrator rights, without a UAC prompt"/>
            <CheckBox x:Name="AutoDisplayCheck" Content="Turn on the cooler display when Sora starts" Margin="0,0,0,18" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <TextBlock Text="SENSOR SOURCE" Style="{StaticResource Eyebrow}" Margin="0,4,0,7"/><TextBlock x:Name="SensorStatus" Text="Starting independent CPU sensors…" TextWrapping="Wrap" FontSize="12" Foreground="#B7C6E0"/>
            <Button Content="About sensors" Click="OpenSensorInfo" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"/>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>
      <Grid Grid.Row="5" Margin="0,14,0,0"><TextBlock Text="Readings refresh once a second and go straight to your cooler." Foreground="#64748E" FontSize="11"/><TextBlock x:Name="LastUpdate" Text="Waiting for live readings" HorizontalAlignment="Right" Foreground="#64748E" FontSize="11"/></Grid>
    </Grid>

    <local:KeyboardPanel x:Name="Keyboard" Grid.Column="1" Visibility="Collapsed" Margin="6,6,6,4"/>
  </Grid>
</Window>
