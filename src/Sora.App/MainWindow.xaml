<Window x:Class="Sora.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" Title="Sora" Width="1260" Height="860" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- Sidebar: brand, one entry per device with a short glanceable status, version. -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,22,12,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,28">
          <Border CornerRadius="8" Width="28" Height="28" Margin="0,0,10,0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4DA3FF" Offset="0"/><GradientStop Color="#0A6CFF" Offset="1"/></LinearGradientBrush></Border.Background>
            <TextBlock Text="S" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
          </Border>
          <TextBlock Text="Sora" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" Text="Sora 0.4" Style="{StaticResource CaptionText}" Margin="10,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Devices" Style="{StaticResource Eyebrow}" Margin="10,0,0,8"/>
          <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="NavChanged" AutomationProperties.Name="Cooler display" ToolTip="Cooler display  (Ctrl+1)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Cooler display" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavDisplayDot" Style="{StaticResource StatusDot}" Width="7" Height="7" Margin="0,1,7,0"/><TextBlock x:Name="NavDisplayStatus" Text="LD360 · Off" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavItem}" GroupName="Nav" Checked="NavChanged" AutomationProperties.Name="Keyboard" ToolTip="Keyboard  (Ctrl+2)">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}"/>
              <StackPanel Grid.Column="1"><TextBlock Text="Keyboard" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="NavKeyboardDot" Style="{StaticResource StatusDot}" Width="7" Height="7" Margin="0,1,7,0"/><TextBlock x:Name="NavKeyboardStatus" Text="Kreo · Not connected" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            </Grid>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="32,28,32,22">
      <!-- Cooler display page. -->
      <Grid x:Name="DisplayPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:PageHeader Title="Cooler display" Subtitle="Live CPU temperature, load and power on your DeepCool LD360.">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DisplayDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0"/><TextBlock x:Name="DeviceLabel" Text="Display off" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Border>
            <Button x:Name="StartButton" Content="Start display" Style="{StaticResource PrimaryButton}" MinWidth="132" Click="ToggleDisplay"/>
          </StackPanel>
        </local:PageHeader>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="CPU temperature" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,2"><TextBlock x:Name="TemperatureValue" Text="—" FontSize="40" FontWeight="SemiBold" Style="{StaticResource NumericText}"/><TextBlock x:Name="TemperatureUnit" Text="°C" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,9" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="Package sensor" Style="{StaticResource CaptionText}"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="CPU usage" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,2"><TextBlock x:Name="UsageValue" Text="—" FontSize="40" FontWeight="SemiBold" Style="{StaticResource NumericText}"/><TextBlock Text="%" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,9" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="Across all cores" Style="{StaticResource CaptionText}"/></StackPanel></Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="CPU power" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,2"><TextBlock x:Name="PowerValue" Text="—" FontSize="40" FontWeight="SemiBold" Style="{StaticResource NumericText}"/><TextBlock Text="W" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,9" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="Package power" Style="{StaticResource CaptionText}"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="On your cooler" Style="{StaticResource Eyebrow}"/>
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="300" MaxWidth="560" Margin="0,16">
                  <Border Background="{StaticResource InsetBrush}" CornerRadius="12" Padding="26,16" Width="380" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}"/><TextBlock x:Name="PreviewTemperature" Text="— °C" FontFamily="Bahnschrift" FontSize="39" Margin="0,2,0,8"/><TextBlock x:Name="PreviewUsage" Text="— %  USAGE" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="PreviewPower" Text="— W  POWER" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource AccentBrush}" Width="3" CornerRadius="2" Margin="15,8,0,8"/></Grid>
                  </Border>
                </Viewbox>
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14,12"><StackPanel><TextBlock x:Name="ConnectionTitle" Text="Ready to connect" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionDetail" Text="Exit DeepCool, then start the display." Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Preferences" Style="{StaticResource Eyebrow}"/><TextBlock Text="Display and app" Style="{StaticResource SectionText}" Margin="0,6,0,12"/>
              <CheckBox x:Name="FahrenheitCheck" Content="Show temperature in Fahrenheit" Margin="0,0,0,6" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="ZerosCheck" Content="Keep leading zeros" Margin="0,0,0,6" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="TrayCheck" Content="Keep running in the tray when closed" Margin="0,0,0,6" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="StartupCheck" Content="Start Sora when I sign in" Margin="0,0,0,6" Checked="StartupChanged" Unchecked="StartupChanged" ToolTip="Starts in the tray with administrator rights, without a UAC prompt"/>
              <CheckBox x:Name="AutoDisplayCheck" Content="Turn on the cooler display at start" Margin="0,0,0,18" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <TextBlock Text="Sensor source" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBlock x:Name="SensorStatus" Text="Starting independent CPU sensors…" Style="{StaticResource SecondaryText}"/>
              <Button Content="About sensors" Click="OpenSensorInfo" Margin="-8,6,0,0" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Grid Grid.Row="5" Margin="0,14,0,0"><TextBlock Text="Readings refresh once a second." Style="{StaticResource CaptionText}"/><TextBlock x:Name="LastUpdate" Text="Waiting for live readings" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Typography.NumeralAlignment="Tabular"/></Grid>
      </Grid>

      <local:KeyboardPanel x:Name="Keyboard" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
