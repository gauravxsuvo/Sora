<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sora</AssemblyName>
    <Version>0.13.0-beta.3</Version>
    <SoraNumericVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-.*$', ''))</SoraNumericVersion>
    <Product>Sora</Product>
    <Description>Hardware controls, GPU fans, SSD health and Wi-Fi antenna tools</Description>
    <ApplicationIcon>../../assets/Sora.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sora mostly idles in the tray: no background GC thread, and the GC hands memory back more readily. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sora.Core/Sora.Core.csproj" />
    <ProjectReference Include="../Sora.UpdateRunner/Sora.UpdateRunner.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Compile Include="../Sora.Update.Windows/*.cs" Link="UpdateWindows/%(Filename)%(Extension)" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <Resource Include="../../assets/Sora.ico" Link="Assets/Sora.ico" />
    <None Include="../../assets/Sora.ico" Link="Assets/sora-brand-$(SoraNumericVersion).ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="../../assets/fonts/Inter/*.ttf" Link="Assets/Fonts/Inter/%(Filename)%(Extension)" />
    <None Include="../../assets/fonts/Inter/LICENSE.txt" Link="licenses/Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><None Include="../../docs/Kreo-keyboard.md" Link="Kreo-keyboard.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Gigabyte-fan-control.md" Link="Gigabyte-fan-control.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/fan-maintenance-workflow.md" Link="fan-maintenance-workflow.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/GCC-hardware-tools.md" Link="GCC-hardware-tools.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Gigabyte-ssd-tool.md" Link="Gigabyte-ssd-tool.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Gigabyte-wifi-compass.md" Link="Gigabyte-wifi-compass.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Gigabyte-gpu-fan-control.md" Link="Gigabyte-gpu-fan-control.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Logitech-GHUB.md" Link="Logitech-GHUB.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/Sora-0.13.0-beta.3.md" Link="ReleaseNotes.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/user-guide.md" Link="user-guide.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/program-files-installation.md" Link="program-files-installation.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/download-warnings.md" Link="download-warnings.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../docs/sora-updater-operations.md" Link="sora-updater-operations.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="PublishUpdateRunner" AfterTargets="Publish">
    <MSBuild Projects="../Sora.UpdateRunner/Sora.UpdateRunner.csproj" Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishSingleFile=false;PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)UpdateRunner/'));UseSharedCompilation=false" />
  </Target>
</Project>
