<UserControl x:Class="Sora.App.UpdatesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:PageHeader Title="Updates" Subtitle="Motherboard BIOS and drivers, plus official hardware maintenance routes.">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="FolderButton" Content="Open downloads" Click="FolderClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
        <Button x:Name="CheckButton" Content="Check for updates" Click="CheckClick" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </local:PageHeader>
    <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,14,0,14" TextWrapping="Wrap" Text="Sora checks only when you press Check for updates. It downloads installers for you to run; it never installs drivers or flashes the BIOS."/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
        <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}">
          <StackPanel>
            <TextBlock Text="This PC" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="BoardText" Text="Motherboard not checked yet" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="BoardDetail" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0">
          <StackPanel>
            <Grid><TextBlock Text="Available updates" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/></Grid>
            <StackPanel x:Name="UpdateList" Margin="0,8,0,0"/>
            <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" Text="Press Check for updates."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Installed version matches or exceeds GCC's entry" Style="{StaticResource Eyebrow}"/>
            <StackPanel x:Name="CurrentList" Margin="0,8,0,0"/>
            <TextBlock x:Name="CurrentEmpty" Style="{StaticResource CaptionText}" Margin="0,10,0,0" Text="—"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="How Sora decides" Style="{StaticResource Eyebrow}"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="BIOS: offered only when your board's exact name matches a single entry in Gigabyte's BIOS list (no guessing between revisions). Drivers: matched to devices actually present in this PC by their hardware IDs, using Gigabyte's own tables, and offered only when the installed version is known and older. Every file comes from mb.download.gigabyte.com and must arrive complete; installers must carry a valid digital signature."/>
            <TextBlock x:Name="NotesText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnTextBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="{StaticResource SectionContentInset}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Device firmware and support" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="CoverageText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <StackPanel x:Name="MaintenanceList" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
