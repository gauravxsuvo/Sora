<UserControl x:Class="Sora.App.LightingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" Focusable="True">

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:PageHeader Title="Lighting" Subtitle="RGB memory and motherboard lighting, without GIGABYTE Control Center.">
      <StackPanel Orientation="Horizontal">
        <Border Style="{StaticResource StatusChip}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Not checked" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Border>
        <Button x:Name="RefreshButton" Content="Check again" Click="RefreshClicked" MinWidth="104"/>
      </StackPanel>
    </local:PageHeader>

    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{StaticResource ScrollContentInset}">
        <!-- Conflict banner: another RGB program owns the hardware, so editing is possible but applying is not. -->
        <Border x:Name="ConflictBanner" Visibility="Collapsed" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <iconPacks:PackIconLucide Kind="TriangleAlert" Width="18" Height="18" Foreground="{StaticResource Warn}" Margin="0,1,12,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1"><TextBlock x:Name="ConflictTitle" Text="" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Exit it from its tray icon (right-click, Exit), then press Check again. Two programs driving the same lights would keep overwriting each other." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
          </Grid>
        </Border>

        <!-- Sync: one look for the RAM and the board, edited in one card instead of two. -->
        <local:Notice x:Name="AvailabilityNotice" Tone="Information" Margin="0,0,0,16" Visibility="Collapsed"/>
        <Border Style="{StaticResource Card}" Padding="24,12,24,12" Margin="0,0,0,16">
          <CheckBox x:Name="SyncToggle" Checked="SyncToggled" Unchecked="SyncToggled" AutomationProperties.Name="Sync memory and motherboard">
            <StackPanel><TextBlock Text="Sync memory and motherboard" FontSize="14"/><TextBlock x:Name="SyncCaption" Text="One effect, colour, brightness and speed for the RAM and every board light." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
          </CheckBox>
        </Border>

        <!-- Sync mode: a single editor; the preview shows both devices. -->
        <Border x:Name="SyncCard" Style="{StaticResource Card}" Padding="20,16,20,18" Visibility="Collapsed">
          <StackPanel>
            <Grid><TextBlock Text="All lighting" Style="{StaticResource SectionText}"/><TextBlock x:Name="SyncDevicesCaption" Text="Memory and motherboard" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/></Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Memory" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                  <StackPanel x:Name="SyncDimmPreview" AutomationProperties.Name="Memory lighting preview"/>
                  <TextBlock Text="Motherboard" Style="{StaticResource FieldLabel}" Margin="0,16,0,8"/>
                  <WrapPanel x:Name="SyncZonePreview" AutomationProperties.Name="Motherboard lighting preview"/>
                  <TextBlock x:Name="SyncNotice" Visibility="Collapsed" Foreground="{StaticResource WarnTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Effect" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="SyncEffectPicker" SelectionChanged="SyncChanged" AutomationProperties.Name="Sync effect"/>
                <Grid x:Name="SyncColorRow" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <local:ColorWheel x:Name="SyncWheel" Width="152" Height="152" AutomationProperties.Name="Sync colour wheel"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Grid HorizontalAlignment="Left">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                      <Border x:Name="SyncColorPreview" CornerRadius="6" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/>
                      <TextBox x:Name="SyncHex" Grid.Column="2" MaxLength="7" TextChanged="SyncChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Sync hex color"/>
                    </Grid>
                    <WrapPanel x:Name="SyncSwatches" Margin="0,10,0,0"/>
                    <TextBlock x:Name="SyncColorError" Style="{StaticResource ValidationMessage}"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="SyncBrightnessLabel" Text="100%" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                    <Slider x:Name="SyncBrightness" Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SyncChanged" AutomationProperties.Name="Sync brightness"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid><TextBlock Text="Speed" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="SyncSpeedLabel" Text="3 / 5" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                    <Slider x:Name="SyncSpeed" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SyncChanged" AutomationProperties.Name="Sync speed"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="SyncHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid x:Name="SeparateCards">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

          <!-- Memory: the two DIMMs, drawn with their real LED count. -->
          <Border Style="{StaticResource Card}" Padding="20,16,20,18">
            <StackPanel>
              <Grid><TextBlock Text="Memory" Style="{StaticResource SectionText}"/><TextBlock x:Name="MemoryCaption" Text="Checking…" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/></Grid>
              <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,12,0,0">
                <StackPanel x:Name="DimmPreview" AutomationProperties.Name="Memory lighting preview"/>
              </Border>
              <TextBlock x:Name="MemoryNotice" Visibility="Collapsed" Foreground="{StaticResource WarnTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <CheckBox x:Name="MemorySyncToggle" Content="Sync RAM modules" IsChecked="True" Checked="MemorySyncToggled" Unchecked="MemorySyncToggled" Margin="0,12,0,0"/>
              <TextBlock Text="Turn off to give each module its own effect and colour. Memory + motherboard sync overrides both modules." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
              <ComboBox x:Name="ModulePicker" DisplayMemberPath="Label" SelectionChanged="ModuleChanged" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.Name="Memory module"/>
              <TextBlock Text="Effect" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
              <ComboBox x:Name="MemoryEffect" SelectionChanged="MemoryChanged" AutomationProperties.Name="Memory effect"/>
              <Grid x:Name="MemoryColorRow" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <local:ColorWheel x:Name="MemoryWheel" Width="152" Height="152" AutomationProperties.Name="Memory colour wheel"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                  <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                    <Border x:Name="MemoryColorPreview" CornerRadius="6" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/>
                    <TextBox x:Name="MemoryHex" Grid.Column="2" MaxLength="7" TextChanged="MemoryChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Memory hex color"/>
                  </Grid>
                  <WrapPanel x:Name="MemorySwatches" Margin="0,10,0,0"/>
                  <TextBlock x:Name="MemoryColorError" Style="{StaticResource ValidationMessage}"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="MemoryBrightnessLabel" Text="100%" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                  <Slider x:Name="MemoryBrightness" Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" AutomationProperties.Name="Memory brightness"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Grid><TextBlock Text="Speed" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="MemorySpeedLabel" Text="3 / 5" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                  <Slider x:Name="MemorySpeed" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" AutomationProperties.Name="Memory speed"/>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="MemoryReverse" Margin="0,8,0,0" Checked="MemoryChanged" Unchecked="MemoryChanged" AutomationProperties.Name="Reverse direction"><StackPanel><TextBlock Text="Reverse direction" FontSize="14"/><TextBlock Text="Rainbow flows the other way along the sticks." Style="{StaticResource CaptionText}"/></StackPanel></CheckBox>
              <TextBlock x:Name="MemoryHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- Motherboard: the RGB Fusion controller drives the board's RGB/ARGB headers. -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,20,18">
            <StackPanel>
              <Grid><TextBlock Text="Motherboard" Style="{StaticResource SectionText}"/><TextBlock x:Name="BoardCaption" Text="Checking…" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              <Grid Margin="0,10,0,6"><TextBlock Text="Lights" Style="{StaticResource FieldLabel}"/><Button x:Name="BoardAllButton" Content="Select all" Click="SelectAllZones" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,-6,-8,-6"/></Grid>
              <WrapPanel x:Name="BoardZonesPanel" AutomationProperties.Name="Motherboard lighting zones"/>
              <TextBlock Text="Effect" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
              <ComboBox x:Name="BoardEffectPicker" SelectionChanged="BoardChanged" AutomationProperties.Name="Motherboard effect"/>
              <Grid x:Name="BoardColorRow" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <local:ColorWheel x:Name="BoardWheel" Width="152" Height="152" AutomationProperties.Name="Motherboard colour wheel"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                  <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                    <Border x:Name="BoardColorPreview" CornerRadius="6" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/>
                    <TextBox x:Name="BoardHex" Grid.Column="2" MaxLength="7" TextChanged="BoardChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Motherboard hex color"/>
                  </Grid>
                  <WrapPanel x:Name="BoardSwatches" Margin="0,10,0,0"/>
                  <TextBlock x:Name="BoardColorError" Style="{StaticResource ValidationMessage}"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="BoardBrightnessLabel" Text="100%" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                  <Slider x:Name="BoardBrightness" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BoardChanged" AutomationProperties.Name="Motherboard brightness"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Grid><TextBlock Text="Speed" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="BoardSpeedLabel" Text="6 / 10" FontSize="13" HorizontalAlignment="Right" Style="{StaticResource NumericText}"/></Grid>
                  <Slider x:Name="BoardSpeed" Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BoardChanged" AutomationProperties.Name="Motherboard speed"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="BoardHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Persistence: what happens at sign-in, and the way back to the RAM's own lighting. -->
        <Border Style="{StaticResource Card}" Padding="24,14,24,12" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
              <CheckBox x:Name="StartupApply" Checked="StartupApplyChanged" Unchecked="StartupApplyChanged" AutomationProperties.Name="Apply when Sora starts"><StackPanel><TextBlock Text="Apply when Sora starts" FontSize="14"/><TextBlock Text="RAM lighting resets after a shutdown, so Sora sets it again at sign-in." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel></CheckBox>
              <CheckBox x:Name="ExitRainbow" Margin="0,10,0,0" Checked="ExitRainbowChanged" Unchecked="ExitRainbowChanged" AutomationProperties.Name="Rainbow when Sora closes"><StackPanel><TextBlock Text="Rainbow when Sora closes" FontSize="14"/><TextBlock Text="Like GCC: the RAM goes back to its own rainbow and the board to its rainbow wave (a board that keeps its lighting stays as it is)." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel></CheckBox>
              <CheckBox x:Name="KeepOnBoard" Margin="0,10,0,0" Checked="KeepOnBoardChanged" Unchecked="KeepOnBoardChanged" AutomationProperties.Name="Keep motherboard lighting after shutdown"><StackPanel><TextBlock Text="Keep motherboard lighting after shutdown" FontSize="14"/><TextBlock x:Name="KeepOnBoardCaption" Text="Saved in the motherboard's lighting controller, as GCC does when it closes, so the board starts with your lighting before Windows loads. Animated sync is kept as its closest built-in effect." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><TextBlock Text="The RAM has no safe save (its only one rewrites the sticks' controller flash, which GCC never does), so Sora sets it at sign-in." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></CheckBox>
            </StackPanel>
            <Grid Grid.Column="2" VerticalAlignment="Top">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Original memory lighting" FontSize="14"/><TextBlock x:Name="BackupText" Text="Saved the first time Sora reads your RAM." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
              <Button x:Name="RestoreButton" Grid.Column="1" Content="Restore" Click="RestoreClicked" VerticalAlignment="Center" IsEnabled="False"/>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="ChangeSummary" Text="No pending changes" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ApplyDetail" Text="" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button x:Name="DiscardButton" Grid.Column="1" Content="Discard edits" Click="DiscardClicked" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Apply lighting" Click="ApplyClicked" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></Grid></Border>
  </Grid>
</UserControl>
