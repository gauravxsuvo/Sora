<UserControl x:Class="Sora.App.ComponentGallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sora.App" Focusable="True" FocusVisualStyle="{x:Null}">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
    <StackPanel Margin="0,0,4,0">
      <local:PageHeader Title="Components" Subtitle="Development preview · shared controls and interaction states">
        <Button Content="Open dialog" Click="OpenDialog" ToolTip="Open a local sample confirmation"/>
      </local:PageHeader>
      <local:Notice x:Name="Feedback" Content="Examples use local sample data. Device settings and saved profiles are never changed." MinHeight="{StaticResource FeedbackRegionHeight}" Margin="0,14,0,16"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{StaticResource SectionColumnGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionSpacing}"><StackPanel>
            <TextBlock Text="Actions" Style="{StaticResource SectionText}" Margin="{StaticResource SectionHeadingInset}"/>
            <WrapPanel><Button x:Name="Primary" Content="Run sample action" Style="{StaticResource PrimaryButton}" Click="ActionClick" Margin="0,0,8,8"/><Button x:Name="ResetButton" Content="Reset sample" Click="ResetClick" Margin="0,0,8,8"/><Button x:Name="HelpButton" Content="Help" Click="HelpClick" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
            <WrapPanel><Button x:Name="BusyButton" Content="Run sample task" Click="SampleTaskClick" MinWidth="144" Margin="0,0,8,0" ToolTip="Run a short local task to preview loading and progress."/><Button x:Name="DisabledButton" Content="Save sample" Click="SaveSampleClick" IsEnabled="False" ToolTip="Enter a profile name to enable this sample action. Nothing is written to disk."/></WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource CompactCard}"><StackPanel>
            <TextBlock Text="Inputs and dropdowns" Style="{StaticResource SectionText}"/>
            <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Input" MaxLength="64" TextChanged="ProfileNameChanged" local:ControlState.Placeholder="Enter a profile name" AutomationProperties.Name="Profile name"/>
            <TextBlock Text="Read-only value" Style="{StaticResource FieldLabel}"/><TextBox Text="Sample keyboard" IsReadOnly="True" AutomationProperties.Name="Read-only sample device"/>
            <TextBlock Text="Hex colour" Style="{StaticResource FieldLabel}"/><TextBox x:Name="InvalidInput" Text="#12" TextChanged="ValidationChanged" MaxLength="7" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Sample hex colour"/><TextBlock x:Name="InvalidMessage" Style="{StaticResource ValidationMessage}"/>
            <TextBlock Text="Enter a full hex value to clear the error." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
            <TextBlock Text="Effect" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Picker" SelectedIndex="0" AutomationProperties.Name="Sample effect"><ComboBoxItem Content="Static"/><ComboBoxItem Content="Breathing"/><ComboBoxItem Content="Custom per-key"/></ComboBox>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CompactCard}" Margin="{StaticResource SectionSpacing}"><StackPanel>
            <TextBlock Text="Settings controls" Style="{StaticResource SectionText}" Margin="{StaticResource SectionHeadingInset}"/>
            <local:SettingsGrid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Enable sample controls" Style="{StaticResource BodyText}" VerticalAlignment="Center"/><CheckBox x:Name="Toggle" Grid.Column="2" IsChecked="True" Checked="SampleToggleChanged" Unchecked="SampleToggleChanged" AutomationProperties.Name="Enable sample controls"/><TextBlock Text="Device-only setting" Grid.Row="1" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,8,0,0"/><CheckBox Grid.Row="1" Grid.Column="2" IsEnabled="False" AutomationProperties.Name="Device-only setting" ToolTip="Unavailable in this preview: there is no device connection." Margin="0,8,0,0"/></local:SettingsGrid>
            <Grid Margin="{StaticResource ControlLabelInset}"><TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Margin="0"/><TextBlock Text="{Binding Value, ElementName=Range, StringFormat={}{0:0}%}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/></Grid><Slider x:Name="Range" Minimum="0" Maximum="100" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Sample brightness"/>
            <TextBlock Text="Device-only brightness" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="100" Value="35" IsEnabled="False" AutomationProperties.Name="Saved brightness example" ToolTip="Example of a saved value that cannot be edited without a device."/>
            <TextBlock Text="Saved value · device controls are unavailable in this preview." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource CompactCard}"><StackPanel>
            <TextBlock Text="Colour and selection" Style="{StaticResource SectionText}" Margin="{StaticResource SectionHeadingInset}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><local:ColorWheel x:Name="Wheel" Width="96" Height="96" AutomationProperties.Name="Sample colour picker"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBox x:Name="Hex" Text="#0A84FF" MaxLength="7" TextChanged="HexChanged" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Hex colour"/><TextBlock x:Name="HexError" Style="{StaticResource ValidationMessage}"/><WrapPanel x:Name="Palette" Margin="0,10,0,0"/></StackPanel></Grid>
            <Border Style="{StaticResource SegmentTrack}" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><RadioButton x:Name="FirstMode" Content="Lighting" GroupName="PreviewMode" IsChecked="True" Checked="SampleModeChanged" Style="{StaticResource Segment}"/><RadioButton x:Name="SecondMode" Content="Profiles" GroupName="PreviewMode" Checked="SampleModeChanged" Style="{StaticResource Segment}"/></StackPanel></Border>
            <TextBlock x:Name="ModeHint" Text="Lighting preview · choose a colour above." Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
          </StackPanel></Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource CompactCard}" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="Feedback examples" Style="{StaticResource SectionText}" Margin="{StaticResource SectionHeadingInset}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{StaticResource SectionColumnGap}"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
          <local:Notice x:Name="InfoNotice" Tone="Information" Content="This is an information message."/><local:Notice x:Name="SuccessNotice" Grid.Column="2" Tone="Success" Content="The sample action completed."/>
          <local:Notice x:Name="WarningNotice" Grid.Row="2" Tone="Warning" Content="Example: reconnect before applying."/><local:Notice x:Name="ErrorNotice" Grid.Row="2" Grid.Column="2" Tone="Error" Content="Example: the device did not respond."/>
        </Grid>
        <Grid Margin="0,12,0,6"><TextBlock Text="Sample task progress" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Value, ElementName=Progress, StringFormat={}{0:0}%}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="60" AutomationProperties.Name="Sample task progress"/>
      </StackPanel></Border>
      <TabControl x:Name="Tabs" Margin="0,16,0,0"><TabItem Header="Overview"><TextBlock Text="Tab content retains normal body weight." Style="{StaticResource BodyText}" Margin="0,10"/></TabItem><TabItem Header="Details"><TextBlock Text="Use arrow keys to move between tab headers." Style="{StaticResource SecondaryText}" Margin="0,10"/></TabItem></TabControl>
      <Border Style="{StaticResource CompactCard}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Lists and editable tables" Style="{StaticResource SectionText}" Margin="{StaticResource SectionHeadingInset}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Choices" SelectedIndex="0" Height="112" BorderThickness="0" AutomationProperties.Name="Preview devices"><ListBoxItem Content="Keyboard"/><ListBoxItem Content="Lighting"/><ListBoxItem Content="Unavailable" IsEnabled="False" ToolTip="Disabled item example: this device type is unavailable."/></ListBox><DataGrid x:Name="Table" Grid.Column="2" Height="112" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionUnit="Cell" AutomationProperties.Name="Editable preview curve"><DataGrid.Columns><DataGridTextColumn Header="Temperature (°C)" Binding="{Binding Temperature}" Width="*"/><DataGridTextColumn Header="Duty (%)" Binding="{Binding Duty}" Width="*"/></DataGrid.Columns></DataGrid></Grid></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
