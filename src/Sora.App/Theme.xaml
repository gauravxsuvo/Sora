7.326 38.195, 123.373 52.292 M 9.670 48.801 C 6.899 54.975, 4.602 63.965, 3.487 73 L 2.808 78.500 9.014 72.500 C 12.427 69.200, 15.845 65.052, 16.610 63.282 C 18.458 59.005, 18.370 52.582, 16.408 48.447 C 13.518 42.356, 12.539 42.408, 9.670 48.801 M 149.724 87.841 C 146.090 91.604, 142.811 95.904, 142.437 97.396 C 141.285 101.984, 142.523 109.522, 145 112.999 L 147.317 116.254 149.134 112.877 C 150.134 111.020, 151.816 106.790, 152.873 103.478 C 154.836 97.326, 157.498 82.164, 156.747 81.413 C 156.518 81.185, 153.358 84.077, 149.724 87.841</Geometry>
  <LinearGradientBrush x:Key="SoraBrandBrush" StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#6030F4" Offset="0"/><GradientStop Color="#9657FF" Offset="1"/></LinearGradientBrush>

  <!-- Bundled static Inter faces give WPF consistent weights without a system font install. -->
  <FontFamily x:Key="UIFont">./Assets/Fonts/Inter/#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UIFont}"/></Style>
  <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style x:Key="SectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/></Style>
  <Style x:Key="SettingNameText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <!-- Small group label above a block of content. -->
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}"/></Style>
  <Style x:Key="SidebarSectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="16"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="Margin" Value="{StaticResource SidebarSectionSpacing}"/></Style>
  <Style x:Key="SidebarLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource NavigationFontSize}"/><Setter Property="LineHeight" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="{StaticResource ControlLabelInset}"/></Style>
  <Style x:Key="NumericText" TargetType="TextBlock"><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>

  <!-- Surfaces. -->
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource GroupCornerRadius}"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{StaticResource SectionContentInset}"/></Style>
  <Style x:Key="StatusChip" TargetType="Border"><Setter Property="Background" Value="{StaticResource NavHoverBrush}"/><Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="11,0,13,0"/><Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="StatusDot" TargetType="Ellipse"><Setter Property="Width" Value="{StaticResource ScrollBarSize}"/><Setter Property="Height" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{StaticResource Idle}"/></Style>

  <!-- Focus ring, drawn only for keyboard navigation. -->
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Buttons: hover and press are overlays, so they work on any fill (including colour swatches). Disabled never uses opacity over a colour. -->
  <Style TargetType="Button">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource ControlBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
        <Grid>
          <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" local:InteractionMotion.OpacityTarget="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          <Border x:Name="FocusOutline" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="{StaticResource ControlRadius}" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
          <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="3,0,3,2" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Working"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="local:InteractionMotion.OpacityTarget" Value="1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}"/><Setter TargetName="Overlay" Property="local:InteractionMotion.OpacityTarget" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Background" Value="{StaticResource ControlDisabledBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="local:ControlState.IsBusy" Value="True"><Setter TargetName="BusyIndicator" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Colour swatch: keeps its colour when disabled, just dimmed. -->
  <Style x:Key="Swatch" TargetType="Button">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SwatchRadius}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Overlay" CornerRadius="{StaticResource SwatchRadius}"/></Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,0"/></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}"/></Style>
  <!-- Text-only action for low-emphasis links such as "About sensors". -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}"/></Style>

  <!-- Settings switch. Content sits on the left, the switch on the right, so rows align in a settings list. -->
  <Style TargetType="CheckBox">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
        <Border x:Name="Track" Grid.Column="1" Width="{StaticResource SwitchWidth}" Height="{StaticResource SwitchHeight}" CornerRadius="12" Background="{StaticResource SwitchOffBrush}" VerticalAlignment="Center">
          <Ellipse x:Name="Knob" Width="{StaticResource SwitchKnobSize}" Height="{StaticResource SwitchKnobSize}" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Knob" Property="local:InteractionMotion.SwitchOffset" Value="16"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Knob" Property="local:InteractionMotion.SwitchOffset" Value="8"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#F2F2F7"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource ControlSelectedBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Sidebar navigation item: content is supplied by MainWindow. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource NavigationFontSize}"/><Setter Property="FontWeight" Value="{StaticResource NavigationFontWeight}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Height" Value="{StaticResource NavigationRowHeight}"/><Setter Property="Margin" Value="{StaticResource NavigationItemSpacing}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Body" Background="Transparent" CornerRadius="{StaticResource NavigationItemRadius}">
        <Grid>
          <Border x:Name="SelectionSurface" Background="{StaticResource NavSelectedBrush}" CornerRadius="{StaticResource NavigationItemRadius}" local:InteractionMotion.OpacityTarget="0" IsHitTestVisible="False"/>
          <Border x:Name="SelectionMarker" Width="2" Height="20" Background="{StaticResource AccentBrush}" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          <ContentPresenter Margin="{StaticResource NavigationItemPadding}"/>
          <Border x:Name="FocusOutline" Margin="1" CornerRadius="{StaticResource NavigationItemRadius}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="Background" Value="{StaticResource NavHoverBrush}"/></MultiTrigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="FontWeight" Value="{StaticResource NavigationSelectedFontWeight}"/><Setter TargetName="SelectionSurface" Property="local:InteractionMotion.OpacityTarget" Value="1"/><Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Navigation geometry is shared: a fixed icon box and one monochrome Lucide stroke style. -->
  <Style x:Key="NavigationIconBox" TargetType="ContentControl">
    <Setter Property="Width" Value="{StaticResource NavigationIconBoxSize}"/><Setter Property="Height" Value="{StaticResource NavigationIconBoxSize}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="NavIcon" TargetType="iconPacks:PackIconLucide">
    <Setter Property="Width" Value="{StaticResource NavigationIconSize}"/><Setter Property="Height" Value="{StaticResource NavigationIconSize}"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="UtilityIcon" TargetType="iconPacks:PackIconLucide">
    <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- Segmented control for editor modes. -->
