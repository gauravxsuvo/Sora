              <Grid><Border x:Name="Overlay" CornerRadius="5"/><iconPacks:PackIconLucide Kind="ChevronDown" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,12,0" Foreground="{StaticResource SecondaryTextBrush}"/></Grid>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlayBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,0,34,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Placeholder" Text="{TemplateBinding local:ControlState.Placeholder}" Foreground="{StaticResource TertiaryTextBrush}" Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="FocusOutline" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Margin="0,0,8,8" Background="{StaticResource PopoverBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <Border.Effect><StaticResource ResourceKey="PopupShadow"/></Border.Effect>
            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="SelectedItem" Value="{x:Null}"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
        <DataTrigger Binding="{Binding Reduced, Source={StaticResource MotionPreferences}}" Value="True"><Setter TargetName="PART_Popup" Property="PopupAnimation" Value="None"/></DataTrigger>
        <Trigger Property="local:ControlState.ReduceMotion" Value="True"><Setter TargetName="PART_Popup" Property="PopupAnimation" Value="None"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="local:ControlState.IsInvalid" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/><Setter TargetName="FocusOutline" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/><Setter Property="Background" Value="{StaticResource ControlDisabledBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Sliders: rail, accent fill and a white thumb. -->
  <Style x:Key="SliderThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Ellipse x:Name="Knob" Width="{StaticResource SliderThumbSize}" Height="{StaticResource SliderThumbSize}" Fill="White" Stroke="{StaticResource HairlineBrush}" StrokeThickness="1"><Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.16" Direction="270"/></Ellipse.Effect></Ellipse>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Stroke" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource ControlSelectedBrush}"/><Setter TargetName="Knob" Property="Stroke" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderRepeat" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Background="{TemplateBinding Background}" CornerRadius="2" Height="{TemplateBinding Height}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="MinHeight" Value="{StaticResource SliderHeight}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent"><Track x:Name="PART_Track" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Fill" Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" Background="{StaticResource AccentBrush}" Height="4"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" Background="{StaticResource ControlSelectedBrush}" Height="4"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
      </Track></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fill" Property="Background" Value="{StaticResource DisabledTextBrush}"/><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slim scrollbars. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{StaticResource ScrollThumbBrush}" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="{StaticResource ScrollBarSize}"/><Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="1"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="1"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
    </Trigger></Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="MaxWidth" Value="360"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{StaticResource PopoverBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="9,5"><Border.Effect><StaticResource ResourceKey="TooltipShadow"/></Border.Effect><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/></Style></ContentPresenter.Resources></ContentPresenter></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Segmented choice built from RadioButtons (editor modes). Sits inside a SegmentTrack border. -->
  <Style x:Key="SegmentTrack" TargetType="Border"><Setter Property="Background" Value="{StaticResource InsetBrush}"/><Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Segment" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" Padding="{StaticResource SegmentPadding}" MinWidth="100"><ContentPresenter HorizontalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource ControlSelectedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource PressedOverlayBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- TabControl whose pages are switched from elsewhere (no header strip). -->
  <Style x:Key="Pages" TargetType="TabControl">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><TabPanel IsItemsHost="True" Visibility="Hidden" Height="0"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" local:InteractionMotion.ContentTransition="True"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Keycap. Sizes are in keyboard design units; the board is scaled as a whole, so proportions never change.
       Tag="Selected" draws the accent ring outside the cap so the key's own colour stays visible. -->
  <SolidColorBrush x:Key="KeycapSurface" Color="#303137"/>
  <Style x:Key="KeyFocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-5" RadiusX="12" RadiusY="12" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeDashArray="2 2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Keycap" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="17"/><Setter Property="Foreground" Value="#E5E5EA"/>
    <Setter Property="Background" Value="{StaticResource KeycapSurface}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}"/><Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="SelectionHalo" Margin="-3" CornerRadius="9" BorderBrush="{StaticResource KeySelectionSeparatorBrush}" BorderThickness="1" Visibility="Collapsed"/>
        <Border x:Name="Ring" Margin="-2" CornerRadius="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="Collapsed"/>
        <Border x:Name="Skirt" CornerRadius="6" Background="#222329" BorderBrush="#484950" BorderThickness="1">
          <Border x:Name="Cap" Margin="1,1,1,3" CornerRadius="5" Background="{TemplateBinding Background}">
            <Grid>
              <Border x:Name="Hover" CornerRadius="6"/>
              <ContentPresenter/>
            </Grid>
          </Border>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#14FFFFFF"/><Setter TargetName="Skirt" Property="BorderBrush" Value="#45464D"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#0AFFFFFF"/></Trigger>
        <Trigger Property="Tag" Value="Selected"><Setter TargetName="SelectionHalo" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Visibility" Value="Visible"/><Setter TargetName="Skirt" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Shared page header: title and description on the left, status and actions on the right. -->
  <Style TargetType="local:PageHeader">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:PageHeader">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource TitleText}"/>
          <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Native selection/editing behaviour is retained; only presentation is shared. -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource ControlRadius}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource NavHoverBrush}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource NavSelectedBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource ControlSelectedBrush}"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Grid Background="{TemplateBinding Background}"><ContentPresenter Margin="{TemplateBinding Padding}"/><Border x:Name="CellFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CellFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="CellFocus" Property="Visibility" Value="Visible"/><Setter TargetName="CellFocus" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger></Style.Triggers>
  </Style>
  <!-- Reusable validation and persistent inline notification surfaces. -->
  <Style x:Key="ValidationMessage" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="InlineNotice" TargetType="Border"><Setter Property="Background" Value="{StaticResource InsetBrush}"/><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/><Setter Property="Padding" Value="{StaticResource NoticePadding}"/></Style>
  <Style TargetType="local:Notice">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="{StaticResource NoticePadding}"/>
    <Setter Property="Background" Value="{StaticResource InsetBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:Notice">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <iconPacks:PackIconLucide x:Name="StatusIcon" Kind="Info" Width="16" Height="16" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,8,0" IsHitTestVisible="False"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="Information" FontWeight="SemiBold" Margin="0,0,0,2"/><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/></Style></ContentPresenter.Resources></ContentPresenter></StackPanel>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Tone" Value="Neutral"><Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="StatusLabel" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Tone" Value="Success"><Setter TargetName="StatusIcon" Property="Kind" Value="CircleCheck"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Good}"/><Setter TargetName="StatusLabel" Property="Text" Value="Success"/></Trigger>
        <Trigger Property="Tone" Value="Warning"><Setter TargetName="StatusIcon" Property="Kind" Value="TriangleAlert"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource WarnTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Warning"/></Trigger>
        <Trigger Property="Tone" Value="Error"><Setter TargetName="StatusIcon" Property="Kind" Value="CircleAlert"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource ErrorTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Error"/></Trigger>
        <Trigger Property="Tone" Value="Loading"><Setter TargetName="StatusIcon" Property="Kind" Value="Loader"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Loading"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="{StaticResource ControlSelectedBrush}"/><Setter Property="Height" Value="4"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
      <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border></Grid>
      <ControlTemplate.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding Reduced, Source={StaticResource MotionPreferences}}" Value="False"/><Condition Binding="{Binding (local:ControlState.ReduceMotion), RelativeSource={RelativeSource TemplatedParent}}" Value="False"/></MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="ProgressAnimation"><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1" Duration="{StaticResource ProgressDuration}" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ProgressAnimation"/></MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KeyboardValidation" TargetType="TextBlock" BasedOn="{StaticResource ValidationMessage}"/>
  <Style x:Key="KeyboardSwatch" TargetType="Button" BasedOn="{StaticResource Swatch}"/>

    <!-- Selectable lighting zone: a colour dot and a name; selected chips get the accent outline. -->
    <Style x:Key="ChoiceChip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Body" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="15" Padding="10,5,12,5"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="{StaticResource AccentSubtleBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ZoneChip" TargetType="ToggleButton" BasedOn="{StaticResource ChoiceChip}"/>
</ResourceDictionary>
