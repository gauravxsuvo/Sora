  <Style x:Key="ValidationMessage" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="InlineNotice" TargetType="Border"><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/><Setter Property="Padding" Value="{StaticResource NoticePadding}"/></Style>
  <Style TargetType="local:Notice">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="{StaticResource NoticePadding}"/>
    <Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:Notice">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ContentControl x:Name="StatusIcon" Style="{StaticResource LineIcon}" Content="{StaticResource IconInfo}" Width="16" Height="16" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="Information" FontWeight="SemiBold" Margin="0,0,0,2"/><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/></Style></ContentPresenter.Resources></ContentPresenter></StackPanel>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Tone" Value="Neutral"><Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="StatusLabel" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Tone" Value="Success"><Setter TargetName="StatusIcon" Property="Content" Value="{StaticResource IconSuccess}"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Good}"/><Setter TargetName="StatusLabel" Property="Text" Value="Success"/></Trigger>
        <Trigger Property="Tone" Value="Warning"><Setter TargetName="StatusIcon" Property="Content" Value="{StaticResource IconWarning}"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource WarnTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Warning"/></Trigger>
        <Trigger Property="Tone" Value="Error"><Setter TargetName="StatusIcon" Property="Content" Value="{StaticResource IconError}"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Error"/></Trigger>
        <Trigger Property="Tone" Value="Loading"><Setter TargetName="StatusIcon" Property="Content" Value="{StaticResource IconLoading}"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Loading"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource ControlSelectedBrush}"/><Setter Property="Height" Value="4"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
      <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border></Grid>
      <ControlTemplate.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding Reduced, Source={StaticResource MotionPreferences}}" Value="False"/><Condition Binding="{Binding (local:ControlState.ReduceMotion), RelativeSource={RelativeSource TemplatedParent}}" Value="False"/></MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="ProgressAnimation"><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1" Duration="{StaticResource ProgressDuration}" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ProgressAnimation"/></MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KeyboardValidation" TargetType="TextBlock" BasedOn="{StaticResource ValidationMessage}"/>
  <Style x:Key="KeyboardSwatch" TargetType="Button" BasedOn="{StaticResource Swatch}"/>

    <!-- Selectable lighting zone: a colour dot and a name; selected chips get the accent outline. -->
    <Style x:Key="ChoiceChip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Body" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="{StaticResource ControlBorderThickness}" CornerRadius="15" Padding="10,5,12,5"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ZoneChip" TargetType="ToggleButton" BasedOn="{StaticResource ChoiceChip}"/>
</ResourceDictionary>
