    <Setter Property="MinHeight" Value="34"/>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="Padding" Value="10,6"/>
