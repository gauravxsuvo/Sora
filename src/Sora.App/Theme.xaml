    <Setter Property="Background" Value="{StaticResource ControlBrush}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="MaxDropDownHeight" Value="340"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
