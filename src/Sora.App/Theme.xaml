<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:Sora.App" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
  <!-- Shared shell and control tokens; device previews may keep their hardware colours. -->

  <!-- Light system palette. Keep shell and native caption colours in sync. -->
  <Color x:Key="WindowColor">#F5F5F7</Color>
  <Color x:Key="WindowCaptionTextColor">#1D1D1F</Color>
  <Color x:Key="WindowBorderColor">#D2D2D7</Color>
  <Color x:Key="SidebarColor">#ECECEF</Color>
  <GridLength x:Key="SidebarWidth">244</GridLength>
  <Thickness x:Key="SidebarInset">12,16,12,14</Thickness>
  <Thickness x:Key="PageInset">28,24,28,20</Thickness>
  <Thickness x:Key="SearchInset">3,0,3,15</Thickness>
  <Thickness x:Key="NavigationItemPadding">10,5</Thickness>
  <Thickness x:Key="NavigationItemSpacing">0,0,0,2</Thickness>
  <Thickness x:Key="SidebarSectionSpacing">10,16,0,6</Thickness>
  <Thickness x:Key="SidebarFirstSectionSpacing">10,0,0,6</Thickness>
  <Thickness x:Key="SidebarBrandSpacing">8,0,0,16</Thickness>
  <Thickness x:Key="SidebarFooterSpacing">0,12,0,0</Thickness>
  <GridLength x:Key="NavigationIconColumnWidth">20</GridLength>
  <GridLength x:Key="NavigationIconLabelGap">10</GridLength>
  <sys:Double x:Key="NavigationRowHeight">36</sys:Double>
  <sys:Double x:Key="NavigationFontSize">14</sys:Double>
  <sys:Double x:Key="NavigationIconBoxSize">20</sys:Double>
  <sys:Double x:Key="NavigationIconSize">18</sys:Double>
  <sys:Double x:Key="SidebarBrandFontSize">16</sys:Double>
  <FontWeight x:Key="NavigationFontWeight">Medium</FontWeight>
  <FontWeight x:Key="NavigationSelectedFontWeight">SemiBold</FontWeight>
  <CornerRadius x:Key="NavigationItemRadius">8</CornerRadius>
  <CornerRadius x:Key="GroupCornerRadius">10</CornerRadius>
  <!-- Component dimensions are WPF device-independent pixels. Keep the approved 32 px controls. -->
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <sys:Double x:Key="CompactControlHeight">28</sys:Double>
  <sys:Double x:Key="ControlFontSize">13</sys:Double>
  <sys:Double x:Key="InputFontSize">14</sys:Double>
  <sys:Double x:Key="CaptionFontSize">12</sys:Double>
  <sys:Double x:Key="SliderHeight">24</sys:Double>
  <sys:Double x:Key="SliderThumbSize">18</sys:Double>
  <sys:Double x:Key="SwitchWidth">40</sys:Double>
  <sys:Double x:Key="SwitchHeight">24</sys:Double>
  <sys:Double x:Key="SwitchKnobSize">20</sys:Double>
  <sys:Double x:Key="ScrollBarSize">8</sys:Double>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="SwatchRadius">5</CornerRadius>
  <CornerRadius x:Key="PopoverRadius">8</CornerRadius>
  <Thickness x:Key="ButtonPadding">14,0</Thickness>
  <Thickness x:Key="InputPadding">8,0</Thickness>
  <Thickness x:Key="NoticePadding">12,8</Thickness>
  <Thickness x:Key="SegmentPadding">16,6</Thickness>
  <Duration x:Key="ProgressDuration">0:0:1.2</Duration>
  <sys:Double x:Key="FeedbackMotionMilliseconds">90</sys:Double>
  <sys:Double x:Key="SelectionMotionMilliseconds">120</sys:Double>
  <sys:Double x:Key="RevealMotionMilliseconds">140</sys:Double>
  <local:MotionPreferences x:Key="MotionPreferences"/>
  <Thickness x:Key="SectionContentInset">20,16</Thickness>
  <Thickness x:Key="ScrollContentInset">0,0,8,24</Thickness>
  <sys:Double x:Key="FeedbackRegionHeight">52</sys:Double>
  <Thickness x:Key="SectionHeadingInset">0,0,0,12</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="ControlLabelInset">0,14,0,6</Thickness>
  <GridLength x:Key="SectionColumnGap">16</GridLength>
  <DropShadowEffect x:Key="PopupShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.16" Direction="270"/>
  <DropShadowEffect x:Key="TooltipShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.14" Direction="270"/>
  <SolidColorBrush x:Key="KeySelectionSeparatorBrush" Color="#E5E5EA"/>
  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F8F8FA"/>
  <SolidColorBrush x:Key="InsetBrush" Color="#F2F2F4"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ControlSelectedBrush" Color="#E6E8ED"/>
  <SolidColorBrush x:Key="ControlDisabledBrush" Color="#EFEFF1"/>
  <SolidColorBrush x:Key="SwitchOffBrush" Color="#D1D1D6"/>
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0D000000"/>
  <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="NavHoverBrush" Color="#10000000"/>
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#DDEAF9"/>
  <SolidColorBrush x:Key="SearchFieldBrush" Color="#F7F7F9"/>
  <SolidColorBrush x:Key="SearchBorderBrush" Color="#C9C9CF"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A1D1D1F"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#801D1D1F"/>
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF5DF"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8C77F"/>
  <SolidColorBrush x:Key="PopoverBrush" Color="#FFFFFF"/>

  <!-- Lines. -->
  <SolidColorBrush x:Key="HairlineBrush" Color="#18000000"/>
  <SolidColorBrush x:Key="SeparatorBrush" Color="#26000000"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#3D000000"/>

  <!-- Text. Secondary and tertiary both stay above 4.5:1 on SurfaceBrush. -->
  <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#626262"/>
  <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B6B6B"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#85858B"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

  <!-- Accent: primary actions, selection and focus only. -->
  <Color x:Key="AccentColor">#0069D9</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#0066CC"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#260069D9"/>

  <!-- States. -->
  <SolidColorBrush x:Key="Good" Color="#248A3D"/>
  <SolidColorBrush x:Key="Warn" Color="#9B6100"/>
  <SolidColorBrush x:Key="Bad" Color="#C52232"/>
  <SolidColorBrush x:Key="Idle" Color="#6E6E73"/>
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#B42318"/>
  <SolidColorBrush x:Key="WarnTextBrush" Color="#875400"/>
  <!-- Legacy names still used by code-behind. -->
  <SolidColorBrush x:Key="Muted" Color="#5F6065"/>

