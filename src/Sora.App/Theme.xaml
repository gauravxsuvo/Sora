    <Setter Property="Background" Value="{StaticResource InsetBrush}"/><Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/><Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
        <Grid><TextBlock x:Name="Placeholder" Text="{TemplateBinding local:ControlState.Placeholder}" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource SearchBorderBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Body" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/></Trigger>
        <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/></Trigger>
        <Trigger Property="local:ControlState.IsInvalid" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/><Setter TargetName="Body" Property="Background" Value="{StaticResource ControlDisabledBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource HairlineBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="AcceptsReturn" Value="True"><Setter Property="VerticalContentAlignment" Value="Top"/></Trigger></Style.Triggers>
