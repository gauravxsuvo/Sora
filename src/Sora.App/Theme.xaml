  <Style x:Key="NavigationSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
    <Setter Property="Background" Value="{StaticResource SearchFieldBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}"/>
