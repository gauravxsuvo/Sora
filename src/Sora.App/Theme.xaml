<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:Sora.App" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
  <!-- Shared shell and control tokens; device previews may keep their hardware colours. -->
  <Style x:Key="TrafficLightButton" TargetType="Button">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Ellipse x:Name="FocusRing" Width="22" Height="22" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Visibility="Collapsed"/>
        <Ellipse x:Name="Dot" Width="13" Height="13" Fill="{TemplateBinding Background}"/>
        <Viewbox x:Name="Glyph" Width="12" Height="12" Visibility="Collapsed">
          <Canvas Width="24" Height="24"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#222222" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
        </Viewbox>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="0.65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Light system palette. Keep shell and native caption colours in sync. -->
  <Color x:Key="WindowColor">#FAFAFA</Color>
  <Color x:Key="WindowCaptionTextColor">#171717</Color>
  <Color x:Key="WindowBorderColor">#D3D3D3</Color>
  <Color x:Key="SidebarColor">#F4F4F4</Color>
  <GridLength x:Key="SidebarWidth">244</GridLength>
  <Thickness x:Key="SidebarInset">12,16,12,14</Thickness>
  <Thickness x:Key="PageInset">28,24,28,20</Thickness>
  <Thickness x:Key="SearchInset">3,0,3,15</Thickness>
  <Thickness x:Key="NavigationItemPadding">10,5</Thickness>
  <Thickness x:Key="NavigationItemSpacing">0,0,0,2</Thickness>
  <Thickness x:Key="SidebarSectionSpacing">10,16,0,6</Thickness>
  <Thickness x:Key="SidebarFirstSectionSpacing">10,0,0,6</Thickness>
  <Thickness x:Key="SidebarBrandSpacing">8,0,0,16</Thickness>
  <Thickness x:Key="SidebarFooterSpacing">0,12,0,0</Thickness>
  <GridLength x:Key="NavigationIconColumnWidth">20</GridLength>
  <GridLength x:Key="NavigationIconLabelGap">10</GridLength>
  <sys:Double x:Key="NavigationRowHeight">36</sys:Double>
  <sys:Double x:Key="NavigationFontSize">14</sys:Double>
  <sys:Double x:Key="NavigationIconBoxSize">20</sys:Double>
  <sys:Double x:Key="NavigationIconSize">20</sys:Double>
  <sys:Double x:Key="SidebarBrandFontSize">16</sys:Double>
  <FontWeight x:Key="NavigationFontWeight">Medium</FontWeight>
  <FontWeight x:Key="NavigationSelectedFontWeight">SemiBold</FontWeight>
  <CornerRadius x:Key="NavigationItemRadius">8</CornerRadius>
  <CornerRadius x:Key="GroupCornerRadius">12</CornerRadius>
  <Thickness x:Key="FrameBorderThickness">2</Thickness>
  <Thickness x:Key="ControlBorderThickness">2</Thickness>
  <!-- Component dimensions are WPF device-independent pixels. Keep the approved 32 px controls. -->
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <sys:Double x:Key="CompactControlHeight">28</sys:Double>
  <sys:Double x:Key="ControlFontSize">13</sys:Double>
  <sys:Double x:Key="InputFontSize">14</sys:Double>
  <sys:Double x:Key="CaptionFontSize">12</sys:Double>
  <sys:Double x:Key="SliderHeight">24</sys:Double>
  <sys:Double x:Key="SliderThumbSize">18</sys:Double>
  <sys:Double x:Key="SwitchWidth">40</sys:Double>
  <sys:Double x:Key="SwitchHeight">24</sys:Double>
  <sys:Double x:Key="SwitchKnobSize">20</sys:Double>
  <sys:Double x:Key="ScrollBarSize">8</sys:Double>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <CornerRadius x:Key="SwatchRadius">5</CornerRadius>
  <CornerRadius x:Key="PopoverRadius">8</CornerRadius>
  <Thickness x:Key="ButtonPadding">14,0</Thickness>
  <Thickness x:Key="InputPadding">8,0</Thickness>
  <Thickness x:Key="NoticePadding">12,8</Thickness>
  <Thickness x:Key="SegmentPadding">16,6</Thickness>
  <Duration x:Key="ProgressDuration">0:0:1.2</Duration>
  <sys:Double x:Key="FeedbackMotionMilliseconds">90</sys:Double>
  <sys:Double x:Key="SelectionMotionMilliseconds">120</sys:Double>
  <sys:Double x:Key="RevealMotionMilliseconds">140</sys:Double>
  <local:MotionPreferences x:Key="MotionPreferences"/>
  <Thickness x:Key="SectionContentInset">20,16</Thickness>
  <Thickness x:Key="ScrollContentInset">0,0,8,24</Thickness>
  <sys:Double x:Key="FeedbackRegionHeight">52</sys:Double>
  <Thickness x:Key="SectionHeadingInset">0,0,0,12</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="ControlLabelInset">0,14,0,6</Thickness>
  <GridLength x:Key="SectionColumnGap">16</GridLength>
  <DropShadowEffect x:Key="PopupShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.16" Direction="270"/>
  <DropShadowEffect x:Key="TooltipShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.14" Direction="270"/>
  <SolidColorBrush x:Key="KeySelectionSeparatorBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="WindowBrush" Color="{DynamicResource WindowColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="InsetBrush" Color="#F4F4F4"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="ControlSelectedBrush" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="SwitchOffBrush" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0D000000"/>
  <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="NavHoverBrush" Color="#10000000"/>
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#ECECEC"/>
  <SolidColorBrush x:Key="SearchFieldBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SearchBorderBrush" Color="#D3D3D3"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66000000"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99000000"/>
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF3DF"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#CFAD70"/>
  <SolidColorBrush x:Key="PopoverBrush" Color="#FFFFFF"/>

  <!-- Lines. -->
  <SolidColorBrush x:Key="HairlineBrush" Color="#C5C5C5"/>
  <SolidColorBrush x:Key="SeparatorBrush" Color="#E3E3E3"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#999999"/>

  <!-- Text. Secondary and tertiary both stay above 4.5:1 on SurfaceBrush. -->
  <SolidColorBrush x:Key="TextBrush" Color="#171717"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555"/>
  <SolidColorBrush x:Key="TertiaryTextBrush" Color="#656565"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#888888"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

  <!-- Accent: primary actions, selection and focus only. -->
  <Color x:Key="AccentColor">#171717</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#333333"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#12000000"/>
  <SolidColorBrush x:Key="ChartBrush" Color="#007A55"/>

  <!-- States. -->
  <SolidColorBrush x:Key="Good" Color="#007A55"/>
  <SolidColorBrush x:Key="Warn" Color="#895800"/>
  <SolidColorBrush x:Key="Bad" Color="#BD252D"/>
  <SolidColorBrush x:Key="Idle" Color="#737373"/>
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#BD252D"/>
  <SolidColorBrush x:Key="WarnTextBrush" Color="#895800"/>
  <!-- Legacy names still used by code-behind. -->
  <SolidColorBrush x:Key="Muted" Color="#555555"/>

  <!-- Brand: geometric reference mark, generated from assets/brand/sora-mark-source.svg. -->
  <Geometry x:Key="SoraMark">F0 M42 8 H86 A34 34 0 0 1 120 42 V86 A34 34 0 0 1 86 120 H42 A34 34 0 0 1 8 86 V42 A34 34 0 0 1 42 8 Z M41 19 A22 22 0 0 1 63 41 V87 A22 22 0 0 1 19 87 V41 A22 22 0 0 1 41 19 Z M59 41 A18 18 0 1 1 23 41 A18 18 0 1 1 59 41 Z M108.5 87 A21.5 21.5 0 1 1 65.5 87 A21.5 21.5 0 1 1 108.5 87 Z</Geometry>
  <SolidColorBrush x:Key="SoraBrandBrush" Color="{DynamicResource WindowCaptionTextColor}"/>

  <!-- Bundled static Inter faces give WPF consistent weights without a system font install. -->
  <FontFamily x:Key="UIFont">./Assets/Fonts/Inter/#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UIFont}"/></Style>
  <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="SectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/></Style>
  <Style x:Key="SettingNameText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <!-- Small group label above a block of content. -->
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/></Style>
  <Style x:Key="SidebarSectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="16"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Margin" Value="{StaticResource SidebarSectionSpacing}"/></Style>
  <Style x:Key="SidebarLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource NavigationFontSize}"/><Setter Property="LineHeight" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="{StaticResource ControlLabelInset}"/></Style>
  <Style x:Key="NumericText" TargetType="TextBlock"><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>

  <!-- Surfaces. -->
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="{StaticResource FrameBorderThickness}"/><Setter Property="CornerRadius" Value="{StaticResource GroupCornerRadius}"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{StaticResource SectionContentInset}"/></Style>
  <Style x:Key="StatusChip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="{StaticResource ControlBorderThickness}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="11,0,13,0"/><Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="StatusDot" TargetType="Ellipse"><Setter Property="Width" Value="{StaticResource ScrollBarSize}"/><Setter Property="Height" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{DynamicResource Idle}"/></Style>

  <!-- Focus ring, drawn only for keyboard navigation. -->
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Buttons: hover and press are overlays, so they work on any fill (including colour swatches). Disabled never uses opacity over a colour. -->
  <Style TargetType="Button">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="{StaticResource ControlBorderThickness}"/>
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
        <Grid>
          <Border x:Name="Overlay" CornerRadius="5" Background="{DynamicResource HoverOverlayBrush}" local:InteractionMotion.OpacityTarget="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          <Border x:Name="FocusOutline" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{StaticResource ControlRadius}" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
          <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="3,0,3,2" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Working"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="local:InteractionMotion.OpacityTarget" Value="1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/><Setter TargetName="Overlay" Property="local:InteractionMotion.OpacityTarget" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlDisabledBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="local:ControlState.IsBusy" Value="True"><Setter TargetName="BusyIndicator" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Colour swatch: keeps its colour when disabled, just dimmed. -->
  <Style x:Key="Swatch" TargetType="Button">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SwatchRadius}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="{StaticResource ControlBorderThickness}"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Overlay" CornerRadius="{StaticResource SwatchRadius}"/></Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,0"/></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}"/></Style>
  <!-- Text-only action for low-emphasis links such as "About sensors". -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}"/></Style>

  <!-- Settings switch. Content sits on the left, the switch on the right, so rows align in a settings list. -->
  <Style TargetType="CheckBox">
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource InputFontSize}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
        <Border x:Name="Track" Grid.Column="1" Width="{StaticResource SwitchWidth}" Height="{StaticResource SwitchHeight}" CornerRadius="12" Background="{DynamicResource SwitchOffBrush}" VerticalAlignment="Center">
          <Ellipse x:Name="Knob" Width="{StaticResource SwitchKnobSize}" Height="{StaticResource SwitchKnobSize}" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}"/><Setter TargetName="Knob" Property="local:InteractionMotion.SwitchOffset" Value="16"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Knob" Property="local:InteractionMotion.SwitchOffset" Value="8"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.7"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Sidebar navigation item: content is supplied by MainWindow. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="{StaticResource NavigationFontSize}"/><Setter Property="FontWeight" Value="{StaticResource NavigationFontWeight}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Height" Value="{StaticResource NavigationRowHeight}"/><Setter Property="Margin" Value="{StaticResource NavigationItemSpacing}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Body" Background="Transparent" CornerRadius="{StaticResource NavigationItemRadius}">
        <Grid>
          <Border x:Name="SelectionSurface" Background="{DynamicResource NavSelectedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="{StaticResource FrameBorderThickness}" CornerRadius="{StaticResource NavigationItemRadius}" local:InteractionMotion.OpacityTarget="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{StaticResource NavigationItemPadding}"/>
          <Border x:Name="FocusOutline" Margin="1" CornerRadius="{StaticResource NavigationItemRadius}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="Background" Value="{DynamicResource NavHoverBrush}"/></MultiTrigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="FontWeight" Value="{StaticResource NavigationSelectedFontWeight}"/><Setter TargetName="SelectionSurface" Property="local:InteractionMotion.OpacityTarget" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Minimal native vectors: one 24-unit grid, one rounded stroke, no per-glyph scaling. -->
  <Geometry x:Key="IconMonitor">M5 4 H19 Q21 4 21 6 V15 Q21 17 19 17 H5 Q3 17 3 15 V6 Q3 4 5 4 Z M9 21 H15 M12 17 V21</Geometry>
  <Geometry x:Key="IconFan">M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M12 12 C8 11 7 7 10 4 M12 12 C15 9 19 10 20 14 M12 12 C13 16 9 19 6 18</Geometry>
  <Geometry x:Key="IconGpu">M5 6 H19 Q21 6 21 8 V16 Q21 18 19 18 H5 Q3 18 3 16 V8 Q3 6 5 6 Z M14 12 A3 3 0 1 1 8 12 A3 3 0 1 1 14 12 M17 10 H18 M17 14 H18 M7 18 V21 M11 18 V21 M3 4 V20</Geometry>
  <Geometry x:Key="IconKeyboard">M5 6 H19 Q21 6 21 8 V16 Q21 18 19 18 H5 Q3 18 3 16 V8 Q3 6 5 6 Z M7 10 H7.1 M12 10 H12.1 M17 10 H17.1 M8 14 H16</Geometry>
  <Geometry x:Key="IconLighting">M16 12 A4 4 0 1 1 8 12 A4 4 0 1 1 16 12 M12 2 V4 M12 20 V22 M2 12 H4 M20 12 H22 M5 5 L6.5 6.5 M17.5 17.5 L19 19 M5 19 L6.5 17.5 M17.5 6.5 L19 5</Geometry>
  <Geometry x:Key="IconMouse">M12 3 C8.5 3 6 5.5 6 9 V15 C6 18.5 8.5 21 12 21 C15.5 21 18 18.5 18 15 V9 C18 5.5 15.5 3 12 3 Z M12 6 V10</Geometry>
  <Geometry x:Key="IconStorage">M5 5 H19 Q21 5 21 7 V17 Q21 19 19 19 H5 Q3 19 3 17 V7 Q3 5 5 5 Z M3 13 H21 M7 16 H7.1 M17 16 H17.1</Geometry>
  <Geometry x:Key="IconWifi">M3 8.5 C8 4 16 4 21 8.5 M6 12 C9.5 9 14.5 9 18 12 M9 15.5 C10.8 14 13.2 14 15 15.5 M12 19 H12.1</Geometry>
  <Geometry x:Key="IconDownload">M12 3 V15 M7 10 L12 15 L17 10 M4 16 V20 Q4 21 5 21 H19 Q20 21 20 20 V16</Geometry>
  <Geometry x:Key="IconSettings">M3 6 H8 M12 6 H21 M3 12 H14 M18 12 H21 M3 18 H5 M9 18 H21 M12 6 A2 2 0 1 1 8 6 A2 2 0 1 1 12 6 M18 12 A2 2 0 1 1 14 12 A2 2 0 1 1 18 12 M9 18 A2 2 0 1 1 5 18 A2 2 0 1 1 9 18</Geometry>
  <Geometry x:Key="IconSearch">M17 10.5 A6.5 6.5 0 1 1 4 10.5 A6.5 6.5 0 1 1 17 10.5 M15.5 15.5 L21 21</Geometry>
  <Geometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</Geometry>
  <Geometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</Geometry>
  <Geometry x:Key="IconWarning">M10.3 4 Q12 1 13.7 4 L22 18.5 Q23 21 20 21 H4 Q1 21 2 18.5 Z M12 9 V13 M12 17 H12.1</Geometry>
  <Geometry x:Key="IconInfo">M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M12 10 V16 M12 7 H12.1</Geometry>
